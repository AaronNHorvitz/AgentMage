ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG DISTRIBUTION
ARG VSCODE_ARCHIVE=vscode-linux-x64.tar.gz
ARG VSCODE_SHA256=acdaf0fa557bda1720956ff65ca0de0965e92d68f97e2db22341984400937aed

LABEL org.agentmage.acceptance.distribution="${DISTRIBUTION}" \
      org.agentmage.acceptance.base-image="${BASE_IMAGE}" \
      org.agentmage.acceptance.vscode-version="1.132.0" \
      org.agentmage.acceptance.vscode-sha256="${VSCODE_SHA256}"

ENV DEBIAN_FRONTEND=noninteractive

COPY ${VSCODE_ARCHIVE} /tmp/vscode-linux-x64.tar.gz

RUN case "${DISTRIBUTION}" in \
      fedora) \
        dnf install -y --setopt=install_weak_deps=False \
          alsa-lib at-spi2-atk bash ca-certificates cairo cups-libs \
          dbus-daemon findutils glib2 gtk3 libX11 libX11-xcb libXcomposite \
          libXcursor libXdamage libXext libXfixes libXi libXrandr \
          libXScrnSaver libXtst libdrm libsecret libxkbcommon mesa-libgbm \
          nss pango procps-ng shadow-utils xorg-x11-server-Xvfb \
          xorg-x11-xauth \
        && dnf clean all \
        ;; \
      ubuntu) \
        apt-get update \
        && apt-get install -y --no-install-recommends \
          bash ca-certificates dbus-x11 findutils grep libasound2t64 \
          libatk-bridge2.0-0t64 libatk1.0-0t64 libcairo2 libcups2t64 \
          libdrm2 libgbm1 libglib2.0-0t64 libgtk-3-0t64 libnspr4 libnss3 \
          libpango-1.0-0 libsecret-1-0 libx11-6 libx11-xcb1 libxcb1 \
          libxcomposite1 libxcursor1 libxdamage1 libxext6 libxfixes3 \
          libxi6 libxkbcommon0 libxrandr2 libxss1 libxtst6 passwd procps \
          xauth xvfb \
        && rm -rf /var/lib/apt/lists/* \
        ;; \
      *) exit 64 ;; \
    esac

RUN printf '%s  %s\n' "${VSCODE_SHA256}" /tmp/vscode-linux-x64.tar.gz \
      | sha256sum --check --strict - \
    && install -d -m 0755 /usr/share/code \
    && tar --extract --gzip --file=/tmp/vscode-linux-x64.tar.gz \
      --strip-components=1 --directory=/usr/share/code \
    && ln -s /usr/share/code/bin/code /usr/bin/code \
    && rm /tmp/vscode-linux-x64.tar.gz \
    && groupadd --gid 10001 agentmage-test \
    && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash agentmage-test \
    && install -d -o 10001 -g 10001 -m 0700 /run/user/10001 \
    && install -d -o 10001 -g 10001 -m 0700 /home/agentmage-test/.config \
    && install -d -o 10001 -g 10001 -m 0700 /home/agentmage-test/.local/share \
    && grep -Fq '"version": "1.132.0"' /usr/share/code/resources/app/package.json

CMD ["/usr/bin/sleep", "infinity"]
