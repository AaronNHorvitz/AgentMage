ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG NODE_VERSION=24.15.0
ARG NODE_SHA256
ARG NPM_VERSION=11.12.1
ARG RUST_VERSION=1.95.0
ARG RUSTUP_INIT_SHA256
ARG SOURCE_CONTENT_SHA256

ENV PATH=/opt/node/bin:/opt/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN set -eux; \
    if command -v dnf >/dev/null 2>&1; then \
      dnf install -y bubblewrap ca-certificates curl gcc git glibc-devel make openssl-devel python3 shadow-utils systemd xz; \
      dnf clean all; \
    else \
      apt-get update; \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bubblewrap build-essential ca-certificates curl git libssl-dev passwd python3 systemd xz-utils; \
      rm -rf /var/lib/apt/lists/*; \
    fi

RUN set -eux; \
    curl --fail --location --silent --show-error \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      --output /tmp/node.tar.xz; \
    echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum --check --strict; \
    mkdir -p /opt/node; \
    tar --extract --xz --file /tmp/node.tar.xz --directory /opt/node --strip-components=1; \
    rm /tmp/node.tar.xz; \
    /opt/node/bin/npm install --global --ignore-scripts --no-audit --no-fund \
      "npm@${NPM_VERSION}"; \
    test "$(/opt/node/bin/node --version)" = "v${NODE_VERSION}"; \
    test "$(/opt/node/bin/npm --version)" = "${NPM_VERSION}"

ENV CARGO_HOME=/opt/cargo
ENV RUSTUP_HOME=/opt/rustup
ENV RUSTUP_NO_UPDATE_CHECK=1

RUN set -eux; \
    curl --fail --location --silent --show-error \
      https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-gnu/rustup-init \
      --output /tmp/rustup-init; \
    echo "${RUSTUP_INIT_SHA256}  /tmp/rustup-init" | sha256sum --check --strict; \
    chmod 0755 /tmp/rustup-init; \
    /tmp/rustup-init -y --no-modify-path --profile minimal \
      --default-toolchain "${RUST_VERSION}" --component clippy,rustfmt; \
    rm /tmp/rustup-init; \
    test "$(cargo --version | cut -d' ' -f2)" = "${RUST_VERSION}"; \
    test "$(rustc --version | cut -d' ' -f2)" = "${RUST_VERSION}"; \
    chmod -R a+rX /opt/cargo /opt/rustup

RUN groupadd --gid 10001 agentmage-build \
    && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash agentmage-build \
    && chown -R 10001:10001 /opt/cargo

COPY --chown=10001:10001 . /source

USER 10001:10001
WORKDIR /source

RUN python3 /source/scripts/clean_standard_build.py \
      --source-root /source \
      --verify-source-content "${SOURCE_CONTENT_SHA256}" \
    && npm ci --ignore-scripts --no-audit --no-fund \
    && cargo fetch --locked

USER 0:0
RUN chmod -R a-w /opt/cargo /opt/rustup /source \
    && chmod -R a+rX /opt/cargo /opt/rustup /source

USER 10001:10001
WORKDIR /tmp
