  "symbol_rules": [
    {
      "allowed_paths": [
        "capabilities/knowledge/src/connected_connector.rs",
        "kernel/contracts/src/network.rs",
        "platforms/linux-inference/src/docker_guard.rs",
        "platforms/linux-inference/src/docker_guard_service.rs",
        "platforms/linux-inference/src/docker_preflight.rs",
        "platforms/linux-inference/src/docker_runtime.rs",
        "platforms/linux-inference/src/docker_topology_collector.rs",
        "platforms/linux/src/inventory.rs"
      ],
      "id": "rust-standard-internet-address-api",
      "pattern": "std::net(?:::|\\s|;)"
    },
    {
      "allowed_paths": [
        "platforms/linux-inference/src/docker_guard_service.rs",
        "platforms/linux-inference/src/docker_http_observer.rs",
        "platforms/linux/src/ipc.rs"
      ],
      "id": "rustix-socket-api",
      "pattern": "rustix::net::"
    },
    {
      "allowed_paths": [
        "platforms/linux-inference/src/docker_guard_service.rs",
        "platforms/linux-inference/src/docker_http_observer.rs",
        "platforms/linux-inference/src/llama_server_driver.rs",
        "platforms/linux/src/ipc.rs"
      ],
      "id": "unix-domain-ipc-api",
      "pattern": "std::os::unix::net::"
    },
    {
      "allowed_paths": [
        "platforms/linux-inference/src/docker_guard_service.rs"
      ],
      "id": "rust-network-client-api",
      "pattern": "(?:TcpStream|TcpListener|UdpSocket|ToSocketAddrs|reqwest::|hyper::|ureq::|curl::|tokio::net::|async_std::net::)"
    },
    {
      "allowed_paths": [
        "shells/vscode/dist/src/host_bridge.js",
        "shells/vscode/src/host_bridge.ts"
      ],
      "id": "javascript-local-ipc-api",
      "pattern": "(?:node:net|require\\([\\\"']net[\\\"']\\))"
    },
    {
      "allowed_paths": [],
      "id": "javascript-network-api",
      "pattern": "(?:node:(?:http|https|tls|dns|dgram)|require\\([\\\"'](?:http|https|tls|dns|dgram)[\\\"']\\)|\\bfetch\\s*\\(|\\bWebSocket\\s*\\(|EventSource\\s*\\()"
    },
    {
      "allowed_paths": [
        "platforms/linux-inference/src/docker_live_collector.rs"
      ],
      "id": "ambient-proxy-or-dns-override",
      "pattern": "(?:HTTP_PROXY|HTTPS_PROXY|ALL_PROXY|NO_PROXY|http_proxy|https_proxy|all_proxy|no_proxy|RES_OPTIONS|HOSTALIASES)"
    },
    {
      "allowed_paths": [],
      "id": "remote-web-asset",
      "pattern": "(?:@import\\s+url|url\\(\\s*[\\\"']?(?:https?|wss?):|src\\s*=\\s*[\\\"'](?:https?|wss?):)"
    },
    {
      "allowed_paths": [],
      "id": "external-network-command",
      "pattern": "(?:Command::new|(?:exec|execFile|spawn)\\s*)\\([\\\"'](?:curl|wget|ssh|scp|nc|ncat|socat)[\\\"']"
    },
    {
      "allowed_paths": [],
      "id": "vscode-external-network-surface",
      "pattern": "(?:env\\.openExternal|vscode\\.open|workbench\\.extensions\\.(?:action|install)|downloadAndInstallExtension)"
    }
  ],
  "vscode_manifest_profile": {
    "activation_events": [
      "onCommand:agentmage.openVerifiedChat",
      "onStartupFinished",
      "onView:agentmage.sessions"
    ],
    "allowed_top_level_keys": [
      "activationEvents",
      "contributes",
      "description",
      "devDependencies",
      "displayName",
      "engines",
      "extensionKind",
      "license",
      "main",
      "name",
      "private",
      "publisher",
      "scripts",
      "type",
      "version"
    ],
    "chat_provider_keys": [
      "displayName",
      "vendor"
    ],
    "contribution_keys": [
      "chatParticipants",
      "commands",
      "configuration",
      "languageModelChatProviders",
      "menus",
      "views",
      "viewsContainers"
    ],
    "contributions": {
      "configuration": {
        "title": "AgentMage feature activation",
        "properties": {
          "agentmage.features.nativeParticipant": {
            "type": "boolean",
            "default": true,
            "description": "Register the bounded native @agentmage compatibility participant. Reload the extension host after changing."
          },
          "agentmage.features.nativeProviderCompatibility": {
            "type": "boolean",
            "default": true,
            "description": "Register the native Language Model Chat Provider compatibility surface. Reload the extension host after changing."
          }
        }
      },
      "commands": [
        {
          "command": "agentmage.openVerifiedChat",
          "title": "Open Verified Chat",
          "category": "AgentMage",
          "icon": "$(comment-discussion)"
        },
        {
          "command": "agentmage.newVerifiedSession",
          "title": "New Verified Session",
          "category": "AgentMage",
          "icon": "$(add)"
        }
      ],
      "chatParticipants": [
        {
          "id": "agentmage.participant",
          "name": "agentmage",
          "fullName": "AgentMage",
          "description": "Run a verified local AgentMage request with completely accounted references",
          "isSticky": true,
          "commands": [
            {
              "name": "ask",
              "description": "Ask over explicitly supplied sources"
            }
          ]
        }
      ],
      "viewsContainers": {
        "activitybar": [
          {
            "id": "agentmage",
            "title": "AgentMage",
            "icon": "media/agentmage.svg"
          }
        ]
      },
      "views": {
        "agentmage": [
          {
            "id": "agentmage.sessions",
            "name": "Sessions",
            "type": "webview"
          }
        ]
      },
      "menus": {
        "view/title": [
          {
            "command": "agentmage.openVerifiedChat",
            "when": "view == agentmage.sessions",
            "group": "navigation"
          },
          {
            "command": "agentmage.newVerifiedSession",
            "when": "view == agentmage.sessions",
            "group": "navigation"
          }
        ]
      },
      "languageModelChatProviders": [
        {
          "vendor": "agentmage",
          "displayName": "AgentMage"
        }
      ]
    },
    "extension_kind": [
      "ui"
    ],
    "main": "./dist/src/extension.js",
    "runtime_packages": [],
    "scripts": {
      "build": "tsc --project tsconfig.json",
      "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.mjs\"",
      "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.mjs\"",
      "lint": "eslint src test",
      "test": "npm run build && node --test \"dist/test/*.test.js\""
    }
  }
}
