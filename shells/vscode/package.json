{
  "name": "@agentmage/vscode-shell",
  "displayName": "AgentMage",
  "publisher": "agentmage-project",
  "version": "0.0.0",
  "private": true,
  "description": "AgentMage Verified Chat and native Visual Studio Code compatibility shell",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "./dist/src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:agentmage.openVerifiedChat",
    "onView:agentmage.sessions"
  ],
  "contributes": {
    "configuration": {
      "title": "AgentMage feature activation",
      "properties": {
        "agentmage.features.nativeParticipant": {
          "type": "boolean",
          "default": true,
          "description": "Register the bounded native @agentmage compatibility participant. Reload the extension host after changing."
        },
        "agentmage.features.nativeProviderCompatibility": {
          "type": "boolean",
          "default": true,
          "description": "Register the native Language Model Chat Provider compatibility surface. Reload the extension host after changing."
        }
      }
    },
    "commands": [
      {
        "command": "agentmage.openVerifiedChat",
        "title": "Open Verified Chat",
        "category": "AgentMage",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agentmage.newVerifiedSession",
        "title": "New Verified Session",
        "category": "AgentMage",
        "icon": "$(add)"
      }
    ],
    "chatParticipants": [
      {
        "id": "agentmage.participant",
        "name": "agentmage",
        "fullName": "AgentMage",
        "description": "Run a verified local AgentMage request with completely accounted references",
        "isSticky": true,
        "commands": [
          {
            "name": "ask",
            "description": "Ask over explicitly supplied sources"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentmage",
          "title": "AgentMage",
          "icon": "media/agentmage.svg"
        }
      ]
    },
    "views": {
      "agentmage": [
        {
          "id": "agentmage.sessions",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "agentmage.openVerifiedChat",
          "when": "view == agentmage.sessions",
          "group": "navigation"
        },
        {
          "command": "agentmage.newVerifiedSession",
          "when": "view == agentmage.sessions",
          "group": "navigation"
        }
      ]
    },
    "languageModelChatProviders": [
      {
        "vendor": "agentmage",
        "displayName": "AgentMage"
      }
    ]
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.mjs\"",
    "lint": "eslint src test",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/vscode": "1.125.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
