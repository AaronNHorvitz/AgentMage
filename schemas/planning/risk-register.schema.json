{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/planning/risk-register.schema.json",
  "title": "AgentMage Risk Register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "updated_at",
    "risks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "risk_register"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    }
  },
  "$defs": {
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_id",
        "title",
        "description",
        "category",
        "likelihood",
        "impact",
        "score",
        "owner",
        "status",
        "requirement_ids",
        "mitigations",
        "evidence",
        "review_by"
      ],
      "properties": {
        "risk_id": {
          "type": "string",
          "pattern": "^RISK-[0-9]{4}$"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "category": {
          "enum": [
            "architecture",
            "authority",
            "data",
            "delivery",
            "model",
            "operations",
            "platform",
            "privacy",
            "quality",
            "supply_chain"
          ]
        },
        "likelihood": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "impact": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "open",
            "mitigating",
            "accepted",
            "closed"
          ]
        },
        "requirement_ids": {
          "$ref": "common.schema.json#/$defs/requirementSet"
        },
        "mitigations": {
          "$ref": "common.schema.json#/$defs/stringSet"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/evidenceArtifact"
          }
        },
        "review_by": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "acceptance_decision_id": {
          "type": "string",
          "pattern": "^ADR-[0-9]{4}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "acceptance_decision_id"
            ],
            "properties": {
              "acceptance_decision_id": {
                "type": "string",
                "pattern": "^ADR-[0-9]{4}$"
              },
              "evidence": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
