{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/planning/decision-record.schema.json",
  "title": "AgentMage Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "decision_id",
    "title",
    "status",
    "date",
    "owners",
    "context",
    "decision",
    "consequences",
    "requirement_ids",
    "supersedes",
    "approved_by",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "decision"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^ADR-[0-9]{4}$"
    },
    "title": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "superseded"
      ]
    },
    "date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "owners": {
      "$ref": "common.schema.json#/$defs/stringSet",
      "type": "array",
      "minItems": 1
    },
    "context": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "decision": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "consequences": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "requirement_ids": {
      "$ref": "common.schema.json#/$defs/requirementSet"
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ADR-[0-9]{4}$"
      }
    },
    "approved_by": {
      "$ref": "common.schema.json#/$defs/stringSet"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/evidenceArtifact"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "array",
            "minItems": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
