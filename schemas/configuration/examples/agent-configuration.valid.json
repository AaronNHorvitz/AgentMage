    "tools": [
      {
        "tool_id": "synthetic-read-file",
        "version": "1.0.0",
        "integrity_sha256": "1111111111111111111111111111111111111111111111111111111111111111",
        "enabled": true,
        "required_capabilities": [
          "workspace.read"
        ],
        "operation": {
          "taxonomy_version": 1,
          "operation": "workspace_read",
          "authority_class": "observe"
        }
      }
    ]
  },
  "permission": {
    "schema_version": 2,
    "default_effect": "deny",
    "authority_inheritance": "restrict-only",
    "model_authority": "none",
    "grant_policy": {
      "single_use": true,
      "expiry_required": true,
      "exact_scope_required": true,
      "transferable": false,
