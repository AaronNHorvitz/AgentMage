    "allowed_capabilities": [
      "workspace.read"
    ],
    "network": {
      "mode": "deny-all",
      "allowed_endpoints": []
    }
  },
  "budget": {
    "schema_version": 2,
    "maximum_input_bytes": 1048576,
    "maximum_output_bytes": 262144,
