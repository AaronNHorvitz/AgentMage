{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/engineering-runtime/source-artifact.schema.json",
  "title": "AgentMage source-artifact",
  "description": "Semantic invariants enforced by createEngineeringRuntimeValidator: custody.backend MUST name the one existing runtime artifact store, custody.artifact_kind MUST remain a member of the frozen RuntimeArtifactKind family, custody.binding MUST be present exactly when custody.state is not not_retained, a retained custody MUST belong to a captured source, and a retained custody.binding MUST repeat the exact source sha256 and byte_length.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_artifact_id",
    "request_id",
    "authority_id",
    "reference_id",
    "origin_id",
    "provenance_sha256",
    "declared_media_type",
    "classification",
    "freshness_state",
    "capture_state",
    "byte_length",
    "sha256",
    "collected_at",
    "custody",
    "source_artifact_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "source_artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "reference_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "origin_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "provenance_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "declared_media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "freshness_state": {
      "enum": [
        "fresh",
        "stale",
        "renamed",
        "replaced",
        "missing",
        "unavailable",
        "unsupported"
      ]
    },
    "capture_state": {
      "enum": [
        "captured",
        "unavailable",
        "unsupported",
        "denied",
        "failed"
      ]
    },
    "byte_length": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 104857600
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "artifact_kind",
        "binding",
        "owner_session_id",
        "owner_task_id",
        "owner_run_id",
        "retention_class",
        "expires_at",
        "state",
        "checkpoint_rooted",
        "release_reason_code"
      ],
      "properties": {
        "backend": {
          "const": "runtime_artifact_store"
        },
        "artifact_kind": {
          "const": "generated_file"
        },
        "binding": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "runtime_artifact_id",
                "payload_sha256",
                "byte_size"
              ],
              "properties": {
                "runtime_artifact_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "payload_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "byte_size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 104857600
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "owner_task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "owner_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "retention_class": {
          "enum": [
            "ephemeral",
            "session",
            "until_expiration",
            "user_hold"
          ]
        },
        "expires_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "not_retained",
            "active",
            "quarantined",
            "released",
            "deleted"
          ]
        },
        "checkpoint_rooted": {
          "type": "boolean"
        },
        "release_reason_code": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_retained"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "binding": {
                "type": "null"
              },
              "retention_class": {
                "const": "ephemeral"
              },
              "checkpoint_rooted": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "binding": {
                "type": "object"
              },
              "retention_class": {
                "enum": [
                  "session",
                  "until_expiration",
                  "user_hold"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "retention_class": {
                "const": "until_expiration"
              }
            },
            "required": [
              "retention_class"
            ]
          },
          "then": {
            "properties": {
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "else": {
            "properties": {
              "expires_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "quarantined",
                  "released",
                  "deleted"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "release_reason_code": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            }
          },
          "else": {
            "properties": {
              "release_reason_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "checkpoint_rooted": {
                "const": true
              }
            },
            "required": [
              "checkpoint_rooted"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "enum": [
                  "active",
                  "quarantined"
                ]
              }
            }
          }
        }
      ]
    },
    "source_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capture_state": {
            "const": "captured"
          }
        },
        "required": [
          "capture_state"
        ]
      },
      "then": {
        "properties": {
          "byte_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 104857600
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "freshness_state": {
            "enum": [
              "fresh",
              "renamed"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "byte_length": {
            "type": "null"
          },
          "sha256": {
            "type": "null"
          }
        }
      }
    }
  ]
}
