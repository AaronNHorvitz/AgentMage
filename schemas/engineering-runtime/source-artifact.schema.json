{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/engineering-runtime/source-artifact.schema.json",
  "title": "AgentMage source-artifact",
  "description": "Semantic invariants enforced by createEngineeringRuntimeValidator: A runtime_payload_store binding MUST carry the captured content address in sha256; an active lifecycle_state MUST retain at least one active logical reference; a deleted lifecycle_state MUST retain no active or checkpoint reference; an eligible cleanup_state MUST retain no active or checkpoint reference; a completed cleanup_state MUST accompany a deleted lifecycle_state; and an ephemeral retention_class MUST NOT be rooted by a current checkpoint reference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_artifact_id",
    "request_id",
    "authority_id",
    "reference_id",
    "origin_id",
    "provenance_sha256",
    "declared_media_type",
    "classification",
    "freshness_state",
    "capture_state",
    "byte_length",
    "sha256",
    "session_id",
    "task_id",
    "owner_scope",
    "retention_class",
    "expires_at",
    "payload_binding",
    "payload_store_id",
    "runtime_artifact_id",
    "runtime_artifact_kind",
    "retention_reason_code",
    "lifecycle_state",
    "cleanup_state",
    "lifecycle_revision",
    "checkpoint_reference_count",
    "active_reference_count",
    "collected_at",
    "source_artifact_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "source_artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "reference_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "origin_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "provenance_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "declared_media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "freshness_state": {
      "enum": [
        "fresh",
        "stale",
        "renamed",
        "replaced",
        "missing",
        "unavailable",
        "unsupported"
      ]
    },
    "capture_state": {
      "enum": [
        "captured",
        "unavailable",
        "unsupported",
        "denied",
        "failed"
      ]
    },
    "byte_length": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 104857600
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "owner_scope": {
      "enum": [
        "session",
        "task",
        "request"
      ]
    },
    "retention_class": {
      "enum": [
        "ephemeral",
        "session",
        "until_expiration",
        "user_hold"
      ]
    },
    "expires_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload_binding": {
      "enum": [
        "memory_only",
        "runtime_payload_store"
      ]
    },
    "payload_store_id": {
      "oneOf": [
        {
          "const": "agentmage-runtime-payload-store-v1"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime_artifact_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime_artifact_kind": {
      "oneOf": [
        {
          "enum": [
            "patch",
            "standard_output",
            "standard_error",
            "test_log",
            "generated_file",
            "report",
            "model_output"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "retention_reason_code": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lifecycle_state": {
      "enum": [
        "active",
        "quarantined",
        "released",
        "deleted"
      ]
    },
    "cleanup_state": {
      "enum": [
        "retained",
        "eligible",
        "blocked",
        "completed"
      ]
    },
    "lifecycle_revision": {
      "type": "integer",
      "minimum": 1
    },
    "checkpoint_reference_count": {
      "type": "integer",
      "minimum": 0
    },
    "active_reference_count": {
      "type": "integer",
      "minimum": 0
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capture_state": {
            "const": "captured"
          }
        },
        "required": [
          "capture_state"
        ]
      },
      "then": {
        "properties": {
          "byte_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 104857600
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "freshness_state": {
            "enum": [
              "fresh",
              "renamed"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "byte_length": {
            "type": "null"
          },
          "sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_binding": {
            "const": "runtime_payload_store"
          }
        },
        "required": [
          "payload_binding"
        ]
      },
      "then": {
        "properties": {
          "payload_store_id": {
            "const": "agentmage-runtime-payload-store-v1"
          },
          "runtime_artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "runtime_artifact_kind": {
            "const": "generated_file"
          },
          "capture_state": {
            "const": "captured"
          }
        }
      },
      "else": {
        "properties": {
          "payload_store_id": {
            "type": "null"
          },
          "runtime_artifact_id": {
            "type": "null"
          },
          "runtime_artifact_kind": {
            "type": "null"
          },
          "lifecycle_state": {
            "enum": [
              "active",
              "released",
              "deleted"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "retention_class": {
            "const": "until_expiration"
          }
        },
        "required": [
          "retention_class"
        ]
      },
      "then": {
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "else": {
        "properties": {
          "expires_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "retention_class": {
            "const": "ephemeral"
          }
        },
        "required": [
          "retention_class"
        ]
      },
      "then": {
        "properties": {
          "payload_binding": {
            "const": "memory_only"
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "payload_binding": {
                "const": "runtime_payload_store"
              }
            },
            "required": [
              "payload_binding"
            ]
          },
          {
            "properties": {
              "retention_class": {
                "not": {
                  "const": "user_hold"
                }
              }
            },
            "required": [
              "retention_class"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "retention_reason_code": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "retention_reason_code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "active"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "properties": {
          "cleanup_state": {
            "const": "retained"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "quarantined"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "properties": {
          "cleanup_state": {
            "const": "blocked"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "released"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "properties": {
          "cleanup_state": {
            "enum": [
              "retained",
              "eligible"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "deleted"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "properties": {
          "cleanup_state": {
            "const": "completed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "checkpoint_reference_count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "checkpoint_reference_count"
        ]
      },
      "then": {
        "properties": {
          "cleanup_state": {
            "enum": [
              "retained",
              "blocked"
            ]
          }
        }
      }
    }
  ]
}
