{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/engineering-runtime/source-artifact.schema.json",
  "title": "AgentMage source-artifact",
  "description": "Semantic invariants enforced by createEngineeringRuntimeValidator: custody.payload_artifact_id and custody.payload_sha256 MUST be absent together or present together, and a present custody.payload_sha256 MUST equal the captured sha256 so retained bytes address the existing content-addressed runtime payload store instead of a second physical store.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_artifact_id",
    "request_id",
    "authority_id",
    "reference_id",
    "origin_id",
    "provenance_sha256",
    "declared_media_type",
    "classification",
    "freshness_state",
    "capture_state",
    "byte_length",
    "sha256",
    "collected_at",
    "custody",
    "source_artifact_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "source_artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "reference_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "origin_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "provenance_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "declared_media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "freshness_state": {
      "enum": [
        "fresh",
        "stale",
        "renamed",
        "replaced",
        "missing",
        "unavailable",
        "unsupported"
      ]
    },
    "capture_state": {
      "enum": [
        "captured",
        "unavailable",
        "unsupported",
        "denied",
        "failed"
      ]
    },
    "byte_length": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 104857600
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_session_id",
        "owner_task_id",
        "retention",
        "custody_state",
        "cleanup_state",
        "payload_backend",
        "payload_artifact_kind",
        "payload_artifact_id",
        "payload_sha256"
      ],
      "properties": {
        "owner_session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "owner_task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expires_at_epoch_ms"
          ],
          "properties": {
            "kind": {
              "enum": [
                "ephemeral",
                "session",
                "until_expiration",
                "user_hold"
              ]
            },
            "expires_at_epoch_ms": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "until_expiration"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "properties": {
                  "expires_at_epoch_ms": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "else": {
                "properties": {
                  "expires_at_epoch_ms": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "custody_state": {
          "enum": [
            "active",
            "quarantined",
            "released",
            "deleted"
          ]
        },
        "cleanup_state": {
          "enum": [
            "retained",
            "eligible",
            "blocked",
            "completed"
          ]
        },
        "payload_backend": {
          "const": "runtime_payload_store"
        },
        "payload_artifact_kind": {
          "const": "generated_file"
        },
        "payload_artifact_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "custody_state": {
                "const": "active"
              }
            },
            "required": [
              "custody_state"
            ]
          },
          "then": {
            "properties": {
              "cleanup_state": {
                "const": "retained"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "custody_state": {
                "const": "quarantined"
              }
            },
            "required": [
              "custody_state"
            ]
          },
          "then": {
            "properties": {
              "cleanup_state": {
                "const": "blocked"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "custody_state": {
                "const": "released"
              }
            },
            "required": [
              "custody_state"
            ]
          },
          "then": {
            "properties": {
              "cleanup_state": {
                "const": "eligible"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "custody_state": {
                "const": "deleted"
              }
            },
            "required": [
              "custody_state"
            ]
          },
          "then": {
            "properties": {
              "cleanup_state": {
                "const": "completed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "custody_state": {
                "const": "deleted"
              }
            },
            "required": [
              "custody_state"
            ]
          },
          "then": {
            "properties": {
              "payload_artifact_id": {
                "type": "null"
              },
              "payload_sha256": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "retention": {
                "properties": {
                  "kind": {
                    "const": "ephemeral"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "retention"
            ]
          },
          "then": {
            "properties": {
              "payload_artifact_id": {
                "type": "null"
              },
              "payload_sha256": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "source_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capture_state": {
            "const": "captured"
          }
        },
        "required": [
          "capture_state"
        ]
      },
      "then": {
        "properties": {
          "byte_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 104857600
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "freshness_state": {
            "enum": [
              "fresh",
              "renamed"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "byte_length": {
            "type": "null"
          },
          "sha256": {
            "type": "null"
          },
          "custody": {
            "properties": {
              "payload_artifact_id": {
                "type": "null"
              },
              "payload_sha256": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
