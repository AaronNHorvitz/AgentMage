{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/engineering-runtime/source-artifact.schema.json",
  "title": "AgentMage source-artifact",
  "description": "Semantic invariants enforced by createEngineeringRuntimeValidator: An expiring retention_class MUST carry an expires_at strictly later than collected_at, a checkpoint_rooted retention_class MUST name at least one checkpoint reference, and any record with checkpoint_reference_count above zero MUST remain active and retained.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_artifact_id",
    "request_id",
    "authority_id",
    "reference_id",
    "origin_id",
    "provenance_sha256",
    "declared_media_type",
    "classification",
    "freshness_state",
    "capture_state",
    "byte_length",
    "sha256",
    "session_id",
    "task_id",
    "owner_class",
    "owner_id",
    "payload_store_id",
    "payload_binding",
    "runtime_artifact_id",
    "retention_class",
    "expires_at",
    "lifecycle",
    "integrity",
    "cleanup",
    "lifecycle_revision",
    "checkpoint_reference_count",
    "shared_payload_reference_count",
    "reason_code",
    "collected_at",
    "source_artifact_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "source_artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "reference_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "origin_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "provenance_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "declared_media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "freshness_state": {
      "enum": [
        "fresh",
        "stale",
        "renamed",
        "replaced",
        "missing",
        "unavailable",
        "unsupported"
      ]
    },
    "capture_state": {
      "enum": [
        "captured",
        "unavailable",
        "unsupported",
        "denied",
        "failed"
      ]
    },
    "byte_length": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 104857600
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "owner_class": {
      "enum": [
        "session",
        "task",
        "turn",
        "request",
        "checkpoint",
        "user_hold"
      ]
    },
    "owner_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "payload_store_id": {
      "const": "runtime-payload-store-v1"
    },
    "payload_binding": {
      "enum": [
        "metadata_only",
        "shared_runtime_payload"
      ]
    },
    "runtime_artifact_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "retention_class": {
      "enum": [
        "session_scoped",
        "task_scoped",
        "checkpoint_rooted",
        "user_hold",
        "expiring",
        "not_retained"
      ]
    },
    "expires_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "lifecycle": {
      "enum": [
        "active",
        "quarantined",
        "released",
        "deleted"
      ]
    },
    "integrity": {
      "enum": [
        "verified",
        "quarantined",
        "missing",
        "corrupt",
        "deleted"
      ]
    },
    "cleanup": {
      "enum": [
        "retained",
        "eligible",
        "blocked",
        "completed"
      ]
    },
    "lifecycle_revision": {
      "type": "integer",
      "minimum": 0
    },
    "checkpoint_reference_count": {
      "type": "integer",
      "minimum": 0
    },
    "shared_payload_reference_count": {
      "type": "integer",
      "minimum": 0
    },
    "reason_code": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capture_state": {
            "const": "captured"
          }
        },
        "required": [
          "capture_state"
        ]
      },
      "then": {
        "properties": {
          "byte_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 104857600
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "freshness_state": {
            "enum": [
              "fresh",
              "renamed"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "byte_length": {
            "type": "null"
          },
          "sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_binding": {
            "const": "shared_runtime_payload"
          }
        },
        "required": [
          "payload_binding"
        ]
      },
      "then": {
        "properties": {
          "capture_state": {
            "const": "captured"
          },
          "runtime_artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "shared_payload_reference_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "else": {
        "properties": {
          "runtime_artifact_id": {
            "type": "null"
          },
          "shared_payload_reference_count": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "retention_class": {
            "const": "not_retained"
          }
        },
        "required": [
          "retention_class"
        ]
      },
      "then": {
        "properties": {
          "payload_binding": {
            "const": "metadata_only"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "retention_class": {
            "const": "expiring"
          }
        },
        "required": [
          "retention_class"
        ]
      },
      "then": {
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "else": {
        "properties": {
          "expires_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "active"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "integrity": {
            "const": "verified"
          },
          "cleanup": {
            "const": "retained"
          },
          "reason_code": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "reason_code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "released"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "integrity": {
            "const": "verified"
          },
          "cleanup": {
            "const": "eligible"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "deleted"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "integrity": {
            "const": "deleted"
          },
          "cleanup": {
            "const": "completed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "integrity": {
            "enum": [
              "quarantined",
              "missing",
              "corrupt"
            ]
          }
        },
        "required": [
          "integrity"
        ]
      },
      "then": {
        "properties": {
          "lifecycle": {
            "const": "quarantined"
          },
          "cleanup": {
            "const": "blocked"
          }
        }
      }
    }
  ]
}
