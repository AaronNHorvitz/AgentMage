{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/engineering-runtime/context-delivery-receipt.schema.json",
  "title": "AgentMage context-delivery-receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "context_manifest_id",
    "context_manifest_sha256",
    "model_request_id",
    "route_decision_id",
    "delivered",
    "required_unseen_artifact_ids",
    "outcome",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "context_manifest_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "context_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "route_decision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "delivered": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "sha256",
          "range",
          "token_count"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "range": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_byte",
              "end_byte_exclusive"
            ],
            "properties": {
              "start_byte": {
                "type": "integer",
                "minimum": 0
              },
              "end_byte_exclusive": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "token_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "required_unseen_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "outcome": {
      "enum": [
        "delivered",
        "blocked"
      ]
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "delivered"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "required_unseen_artifact_ids": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "required_unseen_artifact_ids": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
