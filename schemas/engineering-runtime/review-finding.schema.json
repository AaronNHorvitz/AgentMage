{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/engineering-runtime/review-finding.schema.json",
  "title": "AgentMage review-finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "campaign_id",
    "lease_id",
    "reviewer_id",
    "base_commit",
    "candidate_commit",
    "outcome",
    "severity",
    "code",
    "summary",
    "diff_sha256",
    "finding_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "review_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "lease_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "reviewer_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "candidate_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "outcome": {
      "enum": [
        "PASS",
        "CHANGES_REQUIRED",
        "BLOCKED",
        "DISPUTED"
      ]
    },
    "severity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "diff_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "finding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
