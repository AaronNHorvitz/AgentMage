{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/engineering-runtime/agent-lease.schema.json",
  "title": "AgentMage agent-lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "lease_id",
    "task_id",
    "agent_id",
    "session_id",
    "model_profile_id",
    "endpoint_profile_id",
    "base_commit",
    "worktree_id",
    "branch",
    "path_leases",
    "test_resource_leases",
    "state",
    "correction_limit",
    "correction_count",
    "candidate_commit",
    "lease_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "lease_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "model_profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "endpoint_profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "worktree_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "path_leases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "test_resource_leases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "state": {
      "enum": [
        "ready",
        "leased",
        "implementing",
        "gating",
        "reviewing",
        "correcting",
        "merge_ready",
        "integration_queued",
        "integrating",
        "merged",
        "blocked",
        "disputed",
        "failed",
        "cancelled"
      ]
    },
    "correction_limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "correction_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "candidate_commit": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lease_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
