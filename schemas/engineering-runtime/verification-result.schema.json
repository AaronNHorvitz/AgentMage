{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/engineering-runtime/verification-result.schema.json",
  "title": "AgentMage verification-result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_result_id",
    "workflow_id",
    "step_id",
    "verifier_id",
    "verifier_version",
    "subject_sha256",
    "observed_evidence_sha256s",
    "preserved_invariants",
    "prohibited_effects_observed",
    "outcome",
    "current",
    "result_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "verification_result_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "step_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "verifier_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "verifier_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "subject_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observed_evidence_sha256s": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "preserved_invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "prohibited_effects_observed": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "uncertain"
      ]
    },
    "current": {
      "type": "boolean"
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "passed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "current": {
            "const": true
          },
          "prohibited_effects_observed": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ]
}
