{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/engineering-runtime/multi-agent-campaign.schema.json",
  "title": "AgentMage multi-agent-campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "coordinator_session_id",
    "objective",
    "approved_plan_id",
    "approved_plan_sha256",
    "campaign_branch",
    "starting_commit",
    "campaign_head",
    "max_workers",
    "maximum_concurrent_workers",
    "state",
    "task_ids",
    "leases",
    "integrations",
    "reason_codes",
    "final_evidence",
    "campaign_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "coordinator_session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "approved_plan_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "approved_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "campaign_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "starting_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "campaign_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "max_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "maximum_concurrent_workers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "state": {
      "enum": [
        "planned",
        "ready",
        "running",
        "paused",
        "blocked",
        "cancelled",
        "failed",
        "success"
      ]
    },
    "task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "leases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "campaign_id",
          "lease_id",
          "task_id",
          "agent_id",
          "session_id",
          "model_profile_id",
          "endpoint_profile_id",
          "base_commit",
          "worktree_id",
          "branch",
          "path_leases",
          "test_resource_leases",
          "state",
          "correction_limit",
          "correction_count",
          "candidate_commit",
          "lease_sha256"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "minimum": 1
          },
          "campaign_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "lease_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "agent_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "model_profile_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "endpoint_profile_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "base_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          },
          "worktree_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "branch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "path_leases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          },
          "test_resource_leases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          },
          "state": {
            "enum": [
              "ready",
              "leased",
              "implementing",
              "gating",
              "reviewing",
              "correcting",
              "merge_ready",
              "integration_queued",
              "integrating",
              "merged",
              "blocked",
              "disputed",
              "failed",
              "cancelled"
            ]
          },
          "correction_limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "correction_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "candidate_commit": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40,64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "lease_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "integration_id",
          "campaign_id",
          "lease_id",
          "prior_campaign_head",
          "candidate_commit",
          "resulting_campaign_head",
          "state",
          "gate_evidence_sha256",
          "reason_codes",
          "integration_sha256"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "minimum": 1
          },
          "integration_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "campaign_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "lease_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "prior_campaign_head": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          },
          "candidate_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          },
          "resulting_campaign_head": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40,64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": [
              "queued",
              "revalidating",
              "integrating",
              "integrated",
              "blocked",
              "failed"
            ]
          },
          "gate_evidence_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          },
          "integration_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "final_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "uri",
          "sha256"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "campaign_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "success"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "final_evidence": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "blocked",
              "failed"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
