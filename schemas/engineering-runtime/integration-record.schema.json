{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/engineering-runtime/integration-record.schema.json",
  "title": "AgentMage integration-record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "integration_id",
    "campaign_id",
    "lease_id",
    "prior_campaign_head",
    "candidate_commit",
    "resulting_campaign_head",
    "state",
    "gate_evidence_sha256",
    "reason_codes",
    "integration_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "integration_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "lease_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "prior_campaign_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "candidate_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "resulting_campaign_head": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "queued",
        "revalidating",
        "integrating",
        "integrated",
        "blocked",
        "failed"
      ]
    },
    "gate_evidence_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "integration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
