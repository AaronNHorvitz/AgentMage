            ]
          }
        },
        "required": [
          "locator_kind",
          "availability_state"
        ]
      },
      "then": {
        "required": [
          "section_id"
        ],
        "properties": {
          "byte_range": {
            "type": "null"
          },
          "line_range": {
            "type": "null"
          },
          "page_number": {
            "type": "null"
          },
          "sheet_name": {
            "type": "null"
          },
          "cell_reference": {
            "type": "null"
          },
          "image_region": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "locator_kind": {
            "const": "byte"
          },
          "availability_state": {
            "enum": [
              "complete",
              "partial",
