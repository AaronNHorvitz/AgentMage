        },
        "required": [
          "locator_kind",
          "availability_state"
        ]
      },
      "then": {
        "required": [
          "page_number"
        ],
        "properties": {
          "byte_range": {
            "type": "null"
          },
          "line_range": {
            "type": "null"
          },
          "sheet_name": {
            "type": "null"
          },
          "cell_reference": {
            "type": "null"
          },
          "image_region": {
            "type": "null"
          },
          "section_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "locator_kind": {
            "const": "sheet"
          },
          "availability_state": {
            "enum": [
              "complete",
              "partial",
              "truncated"
            ]
          }
        },
        "required": [
          "locator_kind",
          "availability_state"
        ]
      },
      "then": {
        "required": [
          "sheet_name"
        ],
        "properties": {
          "byte_range": {
            "type": "null"
          },
          "line_range": {
            "type": "null"
          },
          "page_number": {
            "type": "null"
          },
          "cell_reference": {
            "type": "null"
          },
          "image_region": {
            "type": "null"
          },
          "section_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
