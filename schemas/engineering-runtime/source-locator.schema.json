          "availability_state"
        ]
      },
      "then": {
        "required": [
          "sheet_name",
          "cell_reference"
        ],
        "properties": {
          "byte_range": {
            "type": "null"
          },
          "line_range": {
            "type": "null"
          },
          "page_number": {
            "type": "null"
          },
          "image_region": {
            "type": "null"
          },
          "section_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "locator_kind": {
            "const": "image_region"
          },
          "availability_state": {
            "enum": [
              "complete",
              "partial",
              "truncated"
            ]
          }
        },
        "required": [
          "locator_kind",
          "availability_state"
        ]
      },
      "then": {
        "required": [
          "image_region"
        ],
        "properties": {
          "byte_range": {
            "type": "null"
          },
          "line_range": {
            "type": "null"
          },
          "page_number": {
            "type": "null"
          },
          "sheet_name": {
            "type": "null"
          },
          "cell_reference": {
            "type": "null"
          },
          "section_id": {
            "type": "null"
          }
        }
