{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/engineering-runtime/operation-attempt.schema.json",
  "title": "AgentMage operation-attempt",
  "description": "Semantic invariants enforced by createEngineeringRuntimeValidator: supersedes_attempt_id MUST NOT equal attempt_id, and ended_at, when present, MUST NOT precede started_at.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "call_id",
    "step_execution_id",
    "attempt_ordinal",
    "supersedes_attempt_id",
    "grant_id",
    "grant_sha256",
    "executor_identity",
    "sandbox_identity",
    "state",
    "started_at",
    "ended_at",
    "receipt_id",
    "receipt_sha256",
    "observation_id",
    "established_by",
    "attempt_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "call_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "step_execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "attempt_ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_attempt_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "grant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "grant_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executor_identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sandbox_identity": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "started",
        "succeeded",
        "failed",
        "denied",
        "cancelled",
        "timed_out",
        "uncertain"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "observation_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "established_by": {
      "const": "agentmage-runtime"
    },
    "attempt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "started"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "ended_at": {
            "type": "null"
          },
          "receipt_id": {
            "type": "null"
          },
          "receipt_sha256": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "ended_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "receipt_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "attempt_ordinal": {
            "const": 1
          }
        },
        "required": [
          "attempt_ordinal"
        ]
      },
      "then": {
        "properties": {
          "supersedes_attempt_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "supersedes_attempt_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        }
      }
    }
  ]
}
