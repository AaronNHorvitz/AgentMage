{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/image-visual-comparison.schema.json",
  "title": "AgentMage Image Visual Comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "comparison_id", "artifact_kind", "before_rgba_sha256", "after_rgba_sha256", "changed_pixels", "changed_pixel_ratio_ppm", "maximum_channel_delta", "difference_bounds", "machine_checks_passed", "human_visual_review_required", "filesystem_effect_performed", "network_access_performed", "execution_performed"],
  "properties": {
    "schema_version": { "const": 2 },
    "comparison_id": { "$ref": "#/$defs/identifier" },
    "artifact_kind": { "enum": ["document", "slide", "image", "user_interface"] },
    "before_rgba_sha256": { "$ref": "#/$defs/sha256" },
    "after_rgba_sha256": { "$ref": "#/$defs/sha256" },
    "changed_pixels": { "type": "integer", "minimum": 0, "maximum": 67108864 },
    "changed_pixel_ratio_ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "maximum_channel_delta": { "type": "integer", "minimum": 0, "maximum": 255 },
    "difference_bounds": { "oneOf": [{ "$ref": "#/$defs/region" }, { "type": "null" }] },
    "machine_checks_passed": { "type": "boolean" },
    "human_visual_review_required": { "const": true },
    "filesystem_effect_performed": { "const": false },
    "network_access_performed": { "const": false },
    "execution_performed": { "const": false }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "region": { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "integer", "minimum": 0, "maximum": 8191 }, "y": { "type": "integer", "minimum": 0, "maximum": 8191 }, "width": { "type": "integer", "minimum": 1, "maximum": 8192 }, "height": { "type": "integer", "minimum": 1, "maximum": 8192 } } }
  }
}
