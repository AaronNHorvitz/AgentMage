{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/image-redaction-receipt.schema.json",
  "title": "AgentMage Image Redaction Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "redaction_id", "source_rgba_sha256", "output_rgba_sha256", "output_bmp_sha256", "regions", "decoded_pixel_scan_passed", "metadata_removed", "human_visual_review_required", "filesystem_effect_performed", "network_access_performed", "execution_performed"],
  "properties": {
    "schema_version": { "const": 2 },
    "redaction_id": { "$ref": "#/$defs/identifier" },
    "source_rgba_sha256": { "$ref": "#/$defs/sha256" },
    "output_rgba_sha256": { "$ref": "#/$defs/sha256" },
    "output_bmp_sha256": { "$ref": "#/$defs/sha256" },
    "regions": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/region" } },
    "decoded_pixel_scan_passed": { "const": true },
    "metadata_removed": { "const": true },
    "human_visual_review_required": { "const": true },
    "filesystem_effect_performed": { "const": false },
    "network_access_performed": { "const": false },
    "execution_performed": { "const": false }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "region": { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "integer", "minimum": 0, "maximum": 8191 }, "y": { "type": "integer", "minimum": 0, "maximum": 8191 }, "width": { "type": "integer", "minimum": 1, "maximum": 8192 }, "height": { "type": "integer", "minimum": 1, "maximum": 8192 } } }
  }
}
