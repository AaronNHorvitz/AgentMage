{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/tabular-document.schema.json",
  "title": "AgentMage Tabular Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_path", "source_sha256", "profile", "dialect", "headers", "normalized_headers", "rows", "original_preserved", "filesystem_effect_performed", "network_access_performed", "execution_performed"],
  "properties": {
    "schema_version": { "const": 2 },
    "source_path": { "$ref": "#/$defs/workspace_path" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "profile": { "$ref": "#/$defs/profile" },
    "dialect": { "enum": ["comma", "tab", "semicolon"] },
    "headers": { "$ref": "#/$defs/row" },
    "normalized_headers": { "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "rows": { "type": "array", "maxItems": 250000, "items": { "$ref": "#/$defs/row" } },
    "original_preserved": { "const": true },
    "filesystem_effect_performed": { "const": false },
    "network_access_performed": { "const": false },
    "execution_performed": { "const": false }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "workspace_path": { "type": "object", "additionalProperties": false, "required": ["workspace_id", "components"], "properties": { "workspace_id": { "$ref": "#/$defs/identifier" }, "components": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!\\.{1,2}$)(?!.*[/\\\\]).+$" } } } },
    "profile": { "type": "object", "additionalProperties": false, "required": ["profile_id", "maximum_source_bytes", "maximum_rows", "maximum_columns", "maximum_field_bytes"], "properties": { "profile_id": { "$ref": "#/$defs/identifier" }, "maximum_source_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 }, "maximum_rows": { "type": "integer", "minimum": 2, "maximum": 1000000 }, "maximum_columns": { "type": "integer", "minimum": 1, "maximum": 16384 }, "maximum_field_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 } } },
    "row": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "type": "string", "maxLength": 4194304 } }
  }
}
