{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/structured-json-document.schema.json",
  "title": "AgentMage Structured JSON Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_path", "source_sha256", "profile", "schema_id", "value", "canonical_json", "canonical_sha256", "issues", "schema_valid", "original_preserved", "filesystem_effect_performed", "network_access_performed", "execution_performed"],
  "properties": {
    "schema_version": { "const": 2 },
    "source_path": { "$ref": "#/$defs/workspace_path" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "profile": { "$ref": "#/$defs/profile" },
    "schema_id": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
    "value": {},
    "canonical_json": { "$ref": "#/$defs/bytes" },
    "canonical_sha256": { "$ref": "#/$defs/sha256" },
    "issues": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/issue" } },
    "schema_valid": { "type": "boolean" },
    "original_preserved": { "const": true },
    "filesystem_effect_performed": { "const": false },
    "network_access_performed": { "const": false },
    "execution_performed": { "const": false }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bytes": { "type": "array", "maxItems": 268435456, "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
    "workspace_path": { "type": "object", "additionalProperties": false, "required": ["workspace_id", "components"], "properties": { "workspace_id": { "$ref": "#/$defs/identifier" }, "components": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!\\.{1,2}$)(?!.*[/\\\\]).+$" } } } },
    "profile": { "type": "object", "additionalProperties": false, "required": ["profile_id", "maximum_source_bytes", "maximum_depth", "maximum_nodes", "maximum_string_bytes", "number_policy"], "properties": { "profile_id": { "$ref": "#/$defs/identifier" }, "maximum_source_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 }, "maximum_depth": { "type": "integer", "minimum": 1, "maximum": 512 }, "maximum_nodes": { "type": "integer", "minimum": 1, "maximum": 5000000 }, "maximum_string_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }, "number_policy": { "const": "finite-ieee754-round-trip-v1" } } },
    "issue": { "type": "object", "additionalProperties": false, "required": ["pointer", "reason_code"], "properties": { "pointer": { "type": "string", "maxLength": 16777216 }, "reason_code": { "$ref": "#/$defs/code" } } }
  }
}
