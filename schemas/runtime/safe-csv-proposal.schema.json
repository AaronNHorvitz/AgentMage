{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/safe-csv-proposal.schema.json",
  "title": "AgentMage Safe CSV Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_sha256", "csv", "csv_sha256", "formula_sanitized_cell_count", "formula_injection_prevented", "filesystem_effect_performed", "network_access_performed", "execution_performed"],
  "properties": {
    "schema_version": { "const": 2 },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "csv": { "type": "array", "maxItems": 268435456, "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
    "csv_sha256": { "$ref": "#/$defs/sha256" },
    "formula_sanitized_cell_count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "formula_injection_prevented": { "const": true },
    "filesystem_effect_performed": { "const": false },
    "network_access_performed": { "const": false },
    "execution_performed": { "const": false }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
