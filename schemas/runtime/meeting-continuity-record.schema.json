{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/meeting-continuity-record.schema.json",
  "title": "AgentMage Meeting Continuity Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "continuity_record_id", "series_id", "meeting_id", "prior_record_id", "items", "follow_up_draft", "continuity_sha256", "proposal_only", "communication_effect_performed", "source_mutation_performed"],
  "properties": {
    "schema_version": { "const": 2 },
    "continuity_record_id": { "$ref": "#/$defs/identifier" },
    "series_id": { "$ref": "#/$defs/identifier" },
    "meeting_id": { "$ref": "#/$defs/identifier" },
    "prior_record_id": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/identifier" }] },
    "items": { "type": "array", "maxItems": 2048, "items": { "$ref": "#/$defs/item" } },
    "follow_up_draft": { "type": "string", "minLength": 1, "maxLength": 131072 },
    "continuity_sha256": { "$ref": "#/$defs/sha256" },
    "proposal_only": { "const": true },
    "communication_effect_performed": { "const": false },
    "source_mutation_performed": { "const": false }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "field_state": { "enum": ["confirmed", "proposed", "unknown"] },
    "ids": { "type": "array", "minItems": 1, "maxItems": 2048, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["continuity_item_id", "originating_meeting_id", "source_item_id", "state", "text", "owner", "owner_state", "due_date", "due_date_state", "history_item_ids", "source_ids"],
      "properties": {
        "continuity_item_id": { "$ref": "#/$defs/identifier" },
        "originating_meeting_id": { "$ref": "#/$defs/identifier" },
        "source_item_id": { "$ref": "#/$defs/identifier" },
        "state": { "enum": ["open", "completed", "cancelled", "superseded", "unknown"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 131072 },
        "owner": { "type": ["string", "null"], "maxLength": 512 },
        "owner_state": { "$ref": "#/$defs/field_state" },
        "due_date": { "type": ["string", "null"], "format": "date" },
        "due_date_state": { "$ref": "#/$defs/field_state" },
        "history_item_ids": { "$ref": "#/$defs/ids" },
        "source_ids": { "$ref": "#/$defs/ids" }
      }
    }
  }
}
