{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agentmage.dev/schemas/runtime/hosted-source-identity.schema.json","title":"AgentMage Hosted Source Identity","type":"object","additionalProperties":false,"required":["schema_version","host","repository_id","account_id","immutable_revision","immutable_object_id","path","line_start","line_end","retrieved_epoch_milliseconds","canonical_url_sha256"],"properties":{"schema_version":{"const":2},"host":{"$ref":"#/$defs/host"},"repository_id":{"$ref":"#/$defs/id"},"account_id":{"$ref":"#/$defs/id"},"immutable_revision":{"$ref":"#/$defs/sha"},"immutable_object_id":{"$ref":"#/$defs/sha"},"path":{"anyOf":[{"type":"string","minLength":1,"maxLength":2048,"pattern":"^[^/\\\\?#](?:[^\\\\?#]*[^/\\\\?#])?$"},{"type":"null"}]},"line_start":{"anyOf":[{"type":"integer","minimum":1},{"type":"null"}]},"line_end":{"anyOf":[{"type":"integer","minimum":1},{"type":"null"}]},"retrieved_epoch_milliseconds":{"type":"integer","minimum":1},"canonical_url_sha256":{"$ref":"#/$defs/sha"}},"$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"host":{"type":"string","pattern":"^[a-z0-9][a-z0-9.-]*[a-z0-9]$"},"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
