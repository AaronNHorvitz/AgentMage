{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/word-package-edit-preview.schema.json",
  "title": "AgentMage Word Package Edit Preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "edit_id", "source_path", "source_sha256", "output_path", "editor_identity_sha256", "changes", "preserved_parts", "package", "package_sha256", "parts", "warnings", "inspection", "original_preserved", "proposal_only", "filesystem_effect_performed", "network_access_performed", "execution_performed"],
  "properties": {
    "schema_version": { "const": 2 },
    "edit_id": { "$ref": "#/$defs/identifier" },
    "source_path": { "$ref": "#/$defs/workspace_path" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "output_path": { "$ref": "#/$defs/workspace_path" },
    "editor_identity_sha256": { "$ref": "#/$defs/sha256" },
    "changes": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/change" } },
    "preserved_parts": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/preserved_part" } },
    "package": { "type": "array", "maxItems": 67108864, "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
    "package_sha256": { "$ref": "#/$defs/sha256" },
    "parts": { "type": "array", "minItems": 1, "maxItems": 16384, "items": { "$ref": "#/$defs/part" } },
    "warnings": { "type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/warning" } },
    "inspection": { "$ref": "https://agentmage.dev/schemas/runtime/word-inspection-report.schema.json" },
    "original_preserved": { "const": true },
    "proposal_only": { "const": true },
    "filesystem_effect_performed": { "const": false },
    "network_access_performed": { "const": false },
    "execution_performed": { "const": false }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "workspace_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "components"],
      "properties": {
        "workspace_id": { "$ref": "#/$defs/identifier" },
        "components": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!\\.{1,2}$)(?!.*[/\\\\]).+$" } }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_name", "start_byte", "end_byte"],
      "properties": {
        "part_name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "start_byte": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "end_byte": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_id", "operation_kind", "part_name", "before_sha256", "after_sha256", "original_range"],
      "properties": {
        "change_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "operation_kind": { "type": ["string", "null"], "enum": ["replace_text", "redline_replace", "add_comment", null] },
        "part_name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "before_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "after_sha256": { "$ref": "#/$defs/sha256" },
        "original_range": { "anyOf": [{ "$ref": "#/$defs/range" }, { "type": "null" }] }
      }
    },
    "preserved_part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_name", "content_sha256"],
      "properties": {
        "part_name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_name", "content_sha256", "bytes"],
      "properties": {
        "part_name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason_code", "original_remains_authoritative"],
      "properties": {
        "kind": { "enum": ["package_container_rebuilt", "simple_run_redline_only", "main_document_comment_only", "visual_verification_required"] },
        "reason_code": { "$ref": "#/$defs/code" },
        "original_remains_authoritative": { "const": true }
      }
    }
  }
}
