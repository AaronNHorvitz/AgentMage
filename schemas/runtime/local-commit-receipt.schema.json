{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/local-commit-receipt.schema.json",
  "title": "AgentMage Signed Local Commit Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "commit_transaction_id",
    "authority_transaction_id",
    "operation_attempt_id",
    "commit_plan_sha256",
    "approval_receipt_sha256",
    "parent_object",
    "candidate_tree",
    "commit_object",
    "task_branch",
    "signer_sha256",
    "signature_verified",
    "user_index_unchanged",
    "remotes_unchanged",
    "repository_execution_surfaces_disabled",
    "network_used",
    "outcome",
    "before_manifest_sha256",
    "after_manifest_sha256",
    "platform_code",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "commit_transaction_id": { "$ref": "#/$defs/identifier" },
    "authority_transaction_id": { "$ref": "#/$defs/identifier" },
    "operation_attempt_id": { "$ref": "#/$defs/identifier" },
    "commit_plan_sha256": { "$ref": "#/$defs/sha256" },
    "approval_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "parent_object": { "$ref": "#/$defs/object" },
    "candidate_tree": { "$ref": "#/$defs/object" },
    "commit_object": { "$ref": "#/$defs/object" },
    "task_branch": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^refs/heads/agentmage/tasks/[A-Za-z0-9][A-Za-z0-9._/-]*[A-Za-z0-9_-]$"
    },
    "signer_sha256": { "$ref": "#/$defs/sha256" },
    "signature_verified": { "const": true },
    "user_index_unchanged": { "const": true },
    "remotes_unchanged": { "const": true },
    "repository_execution_surfaces_disabled": { "const": true },
    "network_used": { "const": false },
    "outcome": { "const": "succeeded" },
    "before_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "after_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "platform_code": { "$ref": "#/$defs/identifier" },
    "receipt_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "object": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
  }
}
