{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/spreadsheet-inspection.schema.json",
  "title": "AgentMage Spreadsheet Inspection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_path", "source_sha256", "profile", "date_system", "worksheets", "findings", "inspection_complete", "safe_for_analysis", "original_preserved", "filesystem_effect_performed", "network_access_performed", "execution_performed"],
  "properties": {
    "schema_version": { "const": 2 },
    "source_path": { "$ref": "#/$defs/workspace_path" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "profile": { "$ref": "#/$defs/profile" },
    "date_system": { "enum": ["excel1900", "excel1904"] },
    "worksheets": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "#/$defs/worksheet" } },
    "findings": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/finding" } },
    "inspection_complete": { "const": true },
    "safe_for_analysis": { "type": "boolean" },
    "original_preserved": { "const": true },
    "filesystem_effect_performed": { "const": false },
    "network_access_performed": { "const": false },
    "execution_performed": { "const": false }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullable_string": { "oneOf": [{ "type": "string", "maxLength": 16777216 }, { "type": "null" }] },
    "nullable_u32": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 4294967295 }, { "type": "null" }] },
    "workspace_path": { "type": "object", "additionalProperties": false, "required": ["workspace_id", "components"], "properties": { "workspace_id": { "$ref": "#/$defs/identifier" }, "components": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!\\.{1,2}$)(?!.*[/\\\\]).+$" } } } },
    "profile": { "type": "object", "additionalProperties": false, "required": ["profile_id", "maximum_source_bytes", "maximum_entries", "maximum_entry_bytes", "maximum_total_uncompressed_bytes", "maximum_sheets", "maximum_cells", "maximum_shared_strings"], "properties": { "profile_id": { "$ref": "#/$defs/identifier" }, "maximum_source_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 }, "maximum_entries": { "type": "integer", "minimum": 1, "maximum": 65536 }, "maximum_entry_bytes": { "type": "integer", "minimum": 1, "maximum": 134217728 }, "maximum_total_uncompressed_bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 }, "maximum_sheets": { "type": "integer", "minimum": 1, "maximum": 4096 }, "maximum_cells": { "type": "integer", "minimum": 1, "maximum": 5000000 }, "maximum_shared_strings": { "type": "integer", "minimum": 1, "maximum": 5000000 } } },
    "hyperlink": { "type": "object", "additionalProperties": false, "required": ["reference", "target", "target_sha256", "external", "followed"], "properties": { "reference": { "type": "string", "minLength": 1, "maxLength": 64 }, "target": { "type": "string", "minLength": 1, "maxLength": 16777216 }, "target_sha256": { "$ref": "#/$defs/sha256" }, "external": { "type": "boolean" }, "followed": { "const": false } } },
    "cell": { "type": "object", "additionalProperties": false, "required": ["address", "row", "column", "kind", "raw_value", "displayed_value", "formula", "style_index", "number_format_id", "date_value", "hyperlink"], "properties": { "address": { "type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$" }, "row": { "type": "integer", "minimum": 1, "maximum": 1048576 }, "column": { "type": "integer", "minimum": 1, "maximum": 16384 }, "kind": { "enum": ["blank", "shared_string", "inline_string", "string", "number", "boolean", "error", "date", "formula"] }, "raw_value": { "$ref": "#/$defs/nullable_string" }, "displayed_value": { "$ref": "#/$defs/nullable_string" }, "formula": { "$ref": "#/$defs/nullable_string" }, "style_index": { "$ref": "#/$defs/nullable_u32" }, "number_format_id": { "$ref": "#/$defs/nullable_u32" }, "date_value": { "oneOf": [{ "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }, { "type": "null" }] }, "hyperlink": { "oneOf": [{ "$ref": "#/$defs/hyperlink" }, { "type": "null" }] } } },
    "worksheet": { "type": "object", "additionalProperties": false, "required": ["sheet_id", "name", "state", "part_name", "part_sha256", "dimension", "cells", "hidden_rows", "hidden_columns", "merged_ranges", "hyperlinks"], "properties": { "sheet_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 }, "name": { "type": "string", "minLength": 1, "maxLength": 31 }, "state": { "enum": ["visible", "hidden", "very_hidden"] }, "part_name": { "type": "string", "minLength": 1, "maxLength": 4096 }, "part_sha256": { "$ref": "#/$defs/sha256" }, "dimension": { "$ref": "#/$defs/nullable_string" }, "cells": { "type": "array", "maxItems": 5000000, "items": { "$ref": "#/$defs/cell" } }, "hidden_rows": { "type": "array", "maxItems": 1048576, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 1048576 } }, "hidden_columns": { "type": "array", "maxItems": 16384, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 16384 } }, "merged_ranges": { "type": "array", "maxItems": 1000000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }, "hyperlinks": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/hyperlink" } } } },
    "finding": { "type": "object", "additionalProperties": false, "required": ["finding_id", "kind", "part_name", "sheet_name", "cell_reference", "reason_code", "blocks_safe_analysis"], "properties": { "finding_id": { "$ref": "#/$defs/identifier" }, "kind": { "enum": ["macro_content", "external_workbook_reference", "dde_formula", "external_hyperlink", "unsupported_compression"] }, "part_name": { "$ref": "#/$defs/nullable_string" }, "sheet_name": { "$ref": "#/$defs/nullable_string" }, "cell_reference": { "$ref": "#/$defs/nullable_string" }, "reason_code": { "$ref": "#/$defs/code" }, "blocks_safe_analysis": { "type": "boolean" } } }
  }
}
