{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/document-register.schema.json",
  "title": "AgentMage Document Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "register_id", "entries", "register_sha256", "proposal_only", "external_effects_performed", "records_disposition_performed"],
  "properties": {
    "schema_version": { "const": 2 },
    "register_id": { "$ref": "#/$defs/identifier" },
    "entries": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/entry" } },
    "register_sha256": { "$ref": "#/$defs/sha256" },
    "proposal_only": { "const": true },
    "external_effects_performed": { "const": false },
    "records_disposition_performed": { "const": false }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/|~)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$" },
    "nullable_identifier": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/identifier" }] },
    "source_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "statement": {
      "type": "object", "additionalProperties": false,
      "required": ["statement_id", "class", "text", "evidence_state", "owner", "owner_state", "due_date", "due_date_state", "source_ids"],
      "properties": {
        "statement_id": { "$ref": "#/$defs/identifier" },
        "class": { "enum": ["verbatim_source", "observed_fact", "derived_action", "inferred_summary", "unresolved_conflict", "user_approved_final_language"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 262144 },
        "evidence_state": { "enum": ["confirmed", "inferred", "historical", "disputed", "unknown"] },
        "owner": { "type": ["string", "null"], "maxLength": 512 },
        "owner_state": { "enum": ["confirmed", "proposed", "unknown"] },
        "due_date": { "type": ["string", "null"], "format": "date" },
        "due_date_state": { "enum": ["confirmed", "proposed", "unknown"] },
        "source_ids": { "$ref": "#/$defs/source_ids" }
      }
    },
    "attachment": {
      "type": "object", "additionalProperties": false,
      "required": ["attachment_id", "filename", "source_path", "content_sha256", "review_state", "approval_id"],
      "properties": {
        "attachment_id": { "$ref": "#/$defs/identifier" },
        "filename": { "type": "string", "minLength": 1, "maxLength": 512 },
        "source_path": { "$ref": "#/$defs/path" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "review_state": { "enum": ["pending", "approved", "rejected", "unknown"] },
        "approval_id": { "$ref": "#/$defs/nullable_identifier" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "object_id", "fragment", "content_sha256", "observed_revision", "store"],
      "properties": {
        "source_id": { "$ref": "#/$defs/identifier" },
        "object_id": { "$ref": "#/$defs/identifier" },
        "fragment": { "type": ["string", "null"], "maxLength": 512 },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "observed_revision": { "$ref": "#/$defs/nullable_identifier" },
        "store": { "enum": ["plain_folder", "obsidian", "local_message_export", "local_schedule_export"] }
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "kind", "title", "record_category", "version", "lifecycle_state", "approval_id", "named_parties", "quorum_or_status", "quorum_or_status_evidence_state", "attachments", "commitments", "deadlines", "statements", "content_sha256", "source_path", "retention_schedule_id", "accessibility_review_complete", "supersedes_record_id", "superseded_by_record_id", "sources"],
      "properties": {
        "record_id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["document", "correspondence"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "record_category": { "type": ["string", "null"], "maxLength": 512 },
        "version": { "type": "string", "minLength": 1, "maxLength": 512 },
        "lifecycle_state": { "enum": ["draft", "in_review", "approved", "final", "superseded", "unknown"] },
        "approval_id": { "$ref": "#/$defs/nullable_identifier" },
        "named_parties": {
          "type": "array", "maxItems": 4096,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["party_id", "display_name", "role_code", "evidence_state", "source_ids"],
            "properties": {
              "party_id": { "$ref": "#/$defs/identifier" },
              "display_name": { "type": "string", "minLength": 1, "maxLength": 512 },
              "role_code": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
              "evidence_state": { "const": "confirmed" },
              "source_ids": { "$ref": "#/$defs/source_ids" }
            }
          }
        },
        "quorum_or_status": { "type": ["string", "null"], "maxLength": 512 },
        "quorum_or_status_evidence_state": { "enum": ["confirmed", "inferred", "historical", "disputed", "unknown"] },
        "attachments": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/attachment" } },
        "commitments": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/statement" } },
        "deadlines": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/statement" } },
        "statements": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/statement" } },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "source_path": { "$ref": "#/$defs/path" },
        "retention_schedule_id": { "$ref": "#/$defs/nullable_identifier" },
        "accessibility_review_complete": { "type": "boolean" },
        "supersedes_record_id": { "$ref": "#/$defs/nullable_identifier" },
        "superseded_by_record_id": { "$ref": "#/$defs/nullable_identifier" },
        "sources": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/source" } }
      }
    }
  }
}
