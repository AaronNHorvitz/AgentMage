{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/runtime-artifact-reference.schema.json",
  "title": "AgentMage Runtime Artifact Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "manifest_sha256",
    "payload_sha256",
    "byte_size",
    "media_type"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "artifact_id": { "$ref": "#/$defs/identifier" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "payload_sha256": { "$ref": "#/$defs/sha256" },
    "byte_size": { "type": "integer", "minimum": 1, "maximum": 67108864 },
    "media_type": { "$ref": "#/$defs/mediaType" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mediaType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$"
    }
  }
}
