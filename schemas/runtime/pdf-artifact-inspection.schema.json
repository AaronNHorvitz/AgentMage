{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/pdf-artifact-inspection.schema.json",
  "title": "AgentMage PDF Artifact Inspection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_path", "source_sha256", "profile", "pdf_version", "page_count", "encrypted", "metadata", "links", "forms", "images", "findings", "extraction", "inspection_complete", "safe_for_generation_input", "original_preserved", "filesystem_effect_performed", "network_access_performed", "execution_performed"],
  "properties": {
    "schema_version": { "const": 2 },
    "source_path": { "$ref": "#/$defs/workspace_path" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "profile": { "$ref": "https://agentmage.dev/schemas/runtime/pdf-extraction-result.schema.json#/$defs/profile" },
    "pdf_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$", "maxLength": 16 },
    "page_count": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "encrypted": { "type": "boolean" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "links": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/link" } },
    "forms": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/form" } },
    "images": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/image" } },
    "findings": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/finding" } },
    "extraction": { "anyOf": [{ "$ref": "https://agentmage.dev/schemas/runtime/pdf-extraction-result.schema.json" }, { "type": "null" }] },
    "inspection_complete": { "type": "boolean" },
    "safe_for_generation_input": { "type": "boolean" },
    "original_preserved": { "const": true },
    "filesystem_effect_performed": { "const": false },
    "network_access_performed": { "const": false },
    "execution_performed": { "const": false }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "workspace_path": {
      "type": "object", "additionalProperties": false, "required": ["workspace_id", "components"],
      "properties": { "workspace_id": { "$ref": "#/$defs/identifier" }, "components": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$" } } }
    },
    "nullable_text": { "type": ["string", "null"], "maxLength": 16384 },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "author", "subject", "keywords", "creator", "producer", "creation_date", "modification_date", "custom_keys"],
      "properties": {
        "title": { "$ref": "#/$defs/nullable_text" }, "author": { "$ref": "#/$defs/nullable_text" }, "subject": { "$ref": "#/$defs/nullable_text" }, "keywords": { "$ref": "#/$defs/nullable_text" }, "creator": { "$ref": "#/$defs/nullable_text" }, "producer": { "$ref": "#/$defs/nullable_text" }, "creation_date": { "$ref": "#/$defs/nullable_text" }, "modification_date": { "$ref": "#/$defs/nullable_text" },
        "custom_keys": { "type": "array", "maxItems": 4096, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
      }
    },
    "link": {
      "type": "object", "additionalProperties": false,
      "required": ["link_id", "page", "object_number", "object_generation", "kind", "target", "target_sha256", "external_or_active", "followed_or_executed"],
      "properties": {
        "link_id": { "$ref": "#/$defs/identifier" }, "page": { "anyOf": [{ "$ref": "https://agentmage.dev/schemas/runtime/pdf-extraction-result.schema.json#/$defs/page_identity" }, { "type": "null" }] }, "object_number": { "type": ["integer", "null"], "minimum": 1, "maximum": 4294967295 }, "object_generation": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 }, "kind": { "enum": ["internal_destination", "external_uri", "remote_document", "launch", "java_script", "submit_form", "unknown"] }, "target": { "type": ["string", "null"], "maxLength": 16384 }, "target_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "external_or_active": { "type": "boolean" }, "followed_or_executed": { "const": false }
      }
    },
    "form": {
      "type": "object", "additionalProperties": false,
      "required": ["field_id", "object_number", "object_generation", "field_type", "field_name", "field_name_sha256", "has_value"],
      "properties": { "field_id": { "$ref": "#/$defs/identifier" }, "object_number": { "type": "integer", "minimum": 1, "maximum": 4294967295 }, "object_generation": { "type": "integer", "minimum": 0, "maximum": 65535 }, "field_type": { "type": "string", "minLength": 1, "maxLength": 128 }, "field_name": { "type": ["string", "null"], "maxLength": 16384 }, "field_name_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "has_value": { "type": "boolean" } }
    },
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["page", "object_number", "object_generation", "width", "height", "color_space", "filters", "encoded_stream_sha256"],
      "properties": { "page": { "$ref": "https://agentmage.dev/schemas/runtime/pdf-extraction-result.schema.json#/$defs/page_identity" }, "object_number": { "type": "integer", "minimum": 1, "maximum": 4294967295 }, "object_generation": { "type": "integer", "minimum": 0, "maximum": 65535 }, "width": { "type": "integer", "minimum": 1, "maximum": 1000000 }, "height": { "type": "integer", "minimum": 1, "maximum": 1000000 }, "color_space": { "type": ["string", "null"], "maxLength": 256 }, "filters": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }, "encoded_stream_sha256": { "$ref": "#/$defs/sha256" } }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "kind", "object_number", "page_id", "reason_code", "blocks_safe_reuse"],
      "properties": { "finding_id": { "$ref": "#/$defs/identifier" }, "kind": { "enum": ["java_script", "launch_action", "remote_document_action", "submit_form_action", "embedded_file", "automatic_action", "inspection_limited"] }, "object_number": { "type": ["integer", "null"], "minimum": 1, "maximum": 4294967295 }, "page_id": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "reason_code": { "$ref": "#/$defs/code" }, "blocks_safe_reuse": { "type": "boolean" } }
    }
  }
}
