{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/structured-json-redaction.schema.json",
  "title": "AgentMage Structured JSON Redaction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_sha256", "source_canonical_sha256", "policy_id", "redactions", "canonical_json", "canonical_sha256", "original_preserved", "filesystem_effect_performed", "network_access_performed", "execution_performed"],
  "properties": {
    "schema_version": { "const": 2 },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "source_canonical_sha256": { "$ref": "#/$defs/sha256" },
    "policy_id": { "$ref": "#/$defs/identifier" },
    "redactions": { "type": "array", "minItems": 1, "maxItems": 1000000, "items": { "$ref": "#/$defs/redaction" } },
    "canonical_json": { "type": "array", "maxItems": 268435456, "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
    "canonical_sha256": { "$ref": "#/$defs/sha256" },
    "original_preserved": { "const": true },
    "filesystem_effect_performed": { "const": false },
    "network_access_performed": { "const": false },
    "execution_performed": { "const": false }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "redaction": { "type": "object", "additionalProperties": false, "required": ["pointer", "value_sha256"], "properties": { "pointer": { "type": "string", "minLength": 1, "maxLength": 16777216, "pattern": "^/" }, "value_sha256": { "$ref": "#/$defs/sha256" } } }
  }
}
