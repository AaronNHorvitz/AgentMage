{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/candidate-tree-plan.schema.json",
  "title": "AgentMage Authority-Free Candidate Tree Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_build_id",
    "repository_sha256",
    "review_packet_sha256",
    "change_set_sha256",
    "commit_group_sha256",
    "parent_object",
    "temporary_index_path_sha256",
    "user_index_sha256",
    "preservation_manifest_sha256",
    "files",
    "hooks_enabled",
    "filters_enabled",
    "repository_configuration_enabled",
    "network_authority",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate_build_id": { "$ref": "#/$defs/identifier" },
    "repository_sha256": { "$ref": "#/$defs/sha256" },
    "review_packet_sha256": { "$ref": "#/$defs/sha256" },
    "change_set_sha256": { "$ref": "#/$defs/sha256" },
    "commit_group_sha256": { "$ref": "#/$defs/sha256" },
    "parent_object": { "$ref": "#/$defs/object" },
    "temporary_index_path_sha256": { "$ref": "#/$defs/sha256" },
    "user_index_sha256": { "$ref": "#/$defs/sha256" },
    "preservation_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/file" }
    },
    "hooks_enabled": { "const": false },
    "filters_enabled": { "const": false },
    "repository_configuration_enabled": { "const": false },
    "network_authority": { "const": false },
    "plan_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "object": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "path", "postimage_sha256", "mode"],
      "properties": {
        "operation_id": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/path" },
        "postimage_sha256": { "$ref": "#/$defs/sha256" },
        "mode": { "enum": ["regular", "executable"] }
      }
    }
  }
}
