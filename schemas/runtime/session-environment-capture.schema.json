{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/session-environment-capture.schema.json",
  "title": "AgentMage Session Environment Capture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "session_id",
    "captured_at_utc",
    "local_date",
    "timezone_id",
    "current_directory",
    "workspace_roots",
    "active_workspace_id",
    "repository",
    "attachments",
    "platform_family",
    "platform_architecture",
    "os_build_sha256",
    "toolchain_sha256",
    "vscode_build_sha256",
    "package_sha256",
    "permission_profile_id",
    "model_profile_id",
    "model_enabled",
    "configuration_sha256",
    "capture_sha256",
    "authority"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "agentmage-session-environment-v1" },
    "session_id": { "$ref": "#/$defs/identifier" },
    "captured_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "local_date": { "type": "string", "format": "date" },
    "timezone_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_+-]+(?:/[A-Za-z0-9_+-]+)*$"
    },
    "current_directory": { "$ref": "#/$defs/workspaceScope" },
    "workspace_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/workspaceRoot" }
    },
    "active_workspace_id": { "$ref": "#/$defs/identifier" },
    "repository": {
      "oneOf": [
        { "$ref": "#/$defs/repository" },
        { "type": "null" }
      ]
    },
    "attachments": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/attachment" }
    },
    "platform_family": {
      "enum": ["deterministic_fake", "fedora", "ubuntu", "macos_apple_silicon"]
    },
    "platform_architecture": { "enum": ["x86_64", "aarch64"] },
    "os_build_sha256": { "$ref": "#/$defs/sha256" },
    "toolchain_sha256": { "$ref": "#/$defs/sha256" },
    "vscode_build_sha256": { "$ref": "#/$defs/sha256" },
    "package_sha256": { "$ref": "#/$defs/sha256" },
    "permission_profile_id": { "$ref": "#/$defs/identifier" },
    "model_profile_id": { "$ref": "#/$defs/identifier" },
    "model_enabled": { "type": "boolean" },
    "configuration_sha256": { "$ref": "#/$defs/sha256" },
    "capture_sha256": { "$ref": "#/$defs/sha256" },
    "authority": { "const": "descriptive-only" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "oneOf": [
        { "pattern": "^[0-9a-f]{40}$" },
        { "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "pathComponent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!\\.{1,2}$)(?!\\*{1,2}$)[^/\\\\:\\u0000-\\u001f\\u007f]+$"
    },
    "workspaceScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "components"],
      "properties": {
        "workspace_id": { "$ref": "#/$defs/identifier" },
        "components": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/pathComponent" }
        }
      }
    },
    "workspaceRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "components"],
      "properties": {
        "workspace_id": { "$ref": "#/$defs/identifier" },
        "components": { "type": "array", "maxItems": 0 }
      }
    },
    "repositoryHead": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "branch" },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^(?![-./])(?!.*(?:\\.\\.|@\\{|//|\\.lock$))[^ ~^:?*\\[\\]\\\\\\u0000-\\u001f\\u007f]+(?<![./])$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "detached" } }
        }
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "root",
        "repository_sha256",
        "head_commit",
        "head"
      ],
      "properties": {
        "workspace_id": { "$ref": "#/$defs/identifier" },
        "root": { "$ref": "#/$defs/workspaceScope" },
        "repository_sha256": { "$ref": "#/$defs/sha256" },
        "head_commit": { "$ref": "#/$defs/gitObject" },
        "head": { "$ref": "#/$defs/repositoryHead" }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attachment_id",
        "source_id",
        "object_id",
        "byte_len",
        "content_sha256",
        "observed_revision"
      ],
      "properties": {
        "attachment_id": { "$ref": "#/$defs/identifier" },
        "source_id": { "$ref": "#/$defs/boundedText" },
        "object_id": { "$ref": "#/$defs/boundedText" },
        "byte_len": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "observed_revision": { "$ref": "#/$defs/boundedText" }
      }
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
