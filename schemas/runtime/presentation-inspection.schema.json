{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/presentation-inspection.schema.json",
  "title": "AgentMage Presentation Inspection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_path", "source_sha256", "profile", "slides", "findings", "inspection_complete", "safe_for_reuse", "original_preserved", "filesystem_effect_performed", "network_access_performed", "execution_performed"],
  "properties": {
    "schema_version": { "const": 2 },
    "source_path": { "$ref": "#/$defs/workspace_path" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "profile": { "$ref": "#/$defs/profile" },
    "slides": { "type": "array", "minItems": 1, "maxItems": 16384, "items": { "$ref": "#/$defs/slide" } },
    "findings": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/finding" } },
    "inspection_complete": { "const": true },
    "safe_for_reuse": { "type": "boolean" },
    "original_preserved": { "const": true },
    "filesystem_effect_performed": { "const": false },
    "network_access_performed": { "const": false },
    "execution_performed": { "const": false }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullable_string": { "oneOf": [{ "type": "string", "maxLength": 16777216 }, { "type": "null" }] },
    "nullable_u32": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 4294967295 }, { "type": "null" }] },
    "workspace_path": { "type": "object", "additionalProperties": false, "required": ["workspace_id", "components"], "properties": { "workspace_id": { "$ref": "#/$defs/identifier" }, "components": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!\\.{1,2}$)(?!.*[/\\\\]).+$" } } } },
    "profile": { "type": "object", "additionalProperties": false, "required": ["profile_id", "maximum_source_bytes", "maximum_entries", "maximum_entry_bytes", "maximum_total_uncompressed_bytes", "maximum_slides", "maximum_objects", "maximum_text_bytes"], "properties": { "profile_id": { "$ref": "#/$defs/identifier" }, "maximum_source_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 }, "maximum_entries": { "type": "integer", "minimum": 1, "maximum": 65536 }, "maximum_entry_bytes": { "type": "integer", "minimum": 1, "maximum": 134217728 }, "maximum_total_uncompressed_bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 }, "maximum_slides": { "type": "integer", "minimum": 1, "maximum": 16384 }, "maximum_objects": { "type": "integer", "minimum": 1, "maximum": 1000000 }, "maximum_text_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 } } },
    "object": { "type": "object", "additionalProperties": false, "required": ["object_id", "order", "name", "kind", "text", "alternative_text", "caption", "object_sha256"], "properties": { "object_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 }, "order": { "type": "integer", "minimum": 1, "maximum": 1000000 }, "name": { "type": "string", "maxLength": 16777216 }, "kind": { "enum": ["shape", "image", "chart", "table", "diagram", "unsupported"] }, "text": { "type": "array", "maxItems": 1000000, "items": { "type": "string", "maxLength": 16777216 } }, "alternative_text": { "$ref": "#/$defs/nullable_string" }, "caption": { "$ref": "#/$defs/nullable_string" }, "object_sha256": { "$ref": "#/$defs/sha256" } } },
    "link": { "type": "object", "additionalProperties": false, "required": ["object_id", "target", "target_sha256", "external", "followed"], "properties": { "object_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 }, "target": { "type": "string", "minLength": 1, "maxLength": 16777216 }, "target_sha256": { "$ref": "#/$defs/sha256" }, "external": { "type": "boolean" }, "followed": { "const": false } } },
    "image": { "type": "object", "additionalProperties": false, "required": ["object_id", "part_name", "content_sha256", "content_bytes"], "properties": { "object_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 }, "part_name": { "type": "string", "minLength": 1, "maxLength": 4096 }, "content_sha256": { "$ref": "#/$defs/sha256" }, "content_bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 } } },
    "slide": { "type": "object", "additionalProperties": false, "required": ["slide_number", "part_name", "part_sha256", "layout_part_name", "layout_sha256", "objects", "speaker_notes", "links", "images"], "properties": { "slide_number": { "type": "integer", "minimum": 1, "maximum": 16384 }, "part_name": { "type": "string", "minLength": 1, "maxLength": 4096 }, "part_sha256": { "$ref": "#/$defs/sha256" }, "layout_part_name": { "$ref": "#/$defs/nullable_string" }, "layout_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "objects": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/object" } }, "speaker_notes": { "type": "array", "maxItems": 1000000, "items": { "type": "string", "maxLength": 16777216 } }, "links": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/link" } }, "images": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/image" } } } },
    "finding": { "type": "object", "additionalProperties": false, "required": ["finding_id", "kind", "part_name", "slide_number", "reason_code", "blocks_safe_reuse"], "properties": { "finding_id": { "$ref": "#/$defs/identifier" }, "kind": { "enum": ["macro_content", "embedded_executable_content", "external_media", "active_action", "unsupported_content"] }, "part_name": { "$ref": "#/$defs/nullable_string" }, "slide_number": { "$ref": "#/$defs/nullable_u32" }, "reason_code": { "$ref": "#/$defs/code" }, "blocks_safe_reuse": { "type": "boolean" } } }
  }
}
