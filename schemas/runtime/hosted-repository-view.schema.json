{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agentmage.dev/schemas/runtime/hosted-repository-view.schema.json","title":"AgentMage Hosted Repository View","type":"object","additionalProperties":false,"required":["schema_version","view_id","host","repository_id","immutable_revision","fact_count","next_page_cursor_sha256","missing_permission_scopes","unavailable_families","overall_coverage","local_revision","local_identity_matches","hosted_state_changed","local_state_changed","complete","view_sha256"],"properties":{"schema_version":{"const":2},"view_id":{"$ref":"#/$defs/id"},"host":{"type":"string","pattern":"^[a-z0-9][a-z0-9.-]*[a-z0-9]$"},"repository_id":{"$ref":"#/$defs/id"},"immutable_revision":{"$ref":"#/$defs/sha"},"fact_count":{"type":"integer","minimum":1,"maximum":1000},"next_page_cursor_sha256":{"$ref":"#/$defs/nullable_sha"},"missing_permission_scopes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"unavailable_families":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"overall_coverage":{"enum":["complete","partial","unknown","blocked","inaccessible","stale"]},"local_revision":{"$ref":"#/$defs/nullable_sha"},"local_identity_matches":{"type":["boolean","null"]},"hosted_state_changed":{"const":false},"local_state_changed":{"const":false},"complete":{"const":true},"view_sha256":{"$ref":"#/$defs/sha"}},"$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},"nullable_sha":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]}}}
