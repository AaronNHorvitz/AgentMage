{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/pdf-redaction-receipt.schema.json",
  "title": "AgentMage PDF Redaction Receipt",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "redaction_id", "source_pdf_sha256", "output_pdf_sha256", "redactor_identity_sha256", "target_sha256", "layer_checks", "source_specification_reproduced", "full_regeneration_performed", "residue_scan_passed", "human_visual_review_required", "filesystem_effect_performed", "network_access_performed", "execution_performed"],
  "properties": {
    "schema_version": { "const": 2 }, "redaction_id": { "$ref": "#/$defs/identifier" }, "source_pdf_sha256": { "$ref": "#/$defs/sha256" }, "output_pdf_sha256": { "$ref": "#/$defs/sha256" }, "redactor_identity_sha256": { "$ref": "#/$defs/sha256" }, "target_sha256": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } }, "layer_checks": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/check" } }, "source_specification_reproduced": { "const": true }, "full_regeneration_performed": { "const": true }, "residue_scan_passed": { "type": "boolean" }, "human_visual_review_required": { "const": true }, "filesystem_effect_performed": { "const": false }, "network_access_performed": { "const": false }, "execution_performed": { "const": false }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "check": { "type": "object", "additionalProperties": false, "required": ["layer", "residue_count", "passed"], "properties": { "layer": { "enum": ["html_bytes", "pdf_bytes", "pdf_objects", "metadata", "forms", "extracted_text", "incremental_updates"] }, "residue_count": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "passed": { "type": "boolean" } } }
  }
}
