{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agentmage.dev/schemas/runtime/hosted-event-receipt.schema.json","title":"AgentMage Hosted Event Receipt","type":"object","additionalProperties":false,"required":["schema_version","delivery_id","event_kind","payload_sha256","accepted","duplicate","stale","provider_state_changed","local_task_created","receipt_sha256"],"properties":{"schema_version":{"const":2},"delivery_id":{"$ref":"#/$defs/id"},"event_kind":{"$ref":"#/$defs/id"},"payload_sha256":{"$ref":"#/$defs/sha"},"accepted":{"const":true},"duplicate":{"const":false},"stale":{"const":false},"provider_state_changed":{"const":false},"local_task_created":{"const":false},"receipt_sha256":{"$ref":"#/$defs/sha"}},"$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
