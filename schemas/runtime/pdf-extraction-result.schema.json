{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/pdf-extraction-result.schema.json",
  "title": "AgentMage PDF Extraction Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_path", "source_sha256", "extractor_identity_sha256", "profile", "pdf_version", "object_count", "pages", "total_text_bytes", "limitations", "extraction_complete", "ocr_required", "ocr_performed", "original_preserved", "filesystem_effect_performed", "network_access_performed", "execution_performed"],
  "properties": {
    "schema_version": { "const": 2 },
    "source_path": { "$ref": "#/$defs/workspace_path" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "extractor_identity_sha256": { "$ref": "#/$defs/sha256" },
    "profile": { "$ref": "#/$defs/profile" },
    "pdf_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$", "maxLength": 16 },
    "object_count": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "pages": { "type": "array", "minItems": 1, "maxItems": 100000, "items": { "$ref": "#/$defs/page" } },
    "total_text_bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 },
    "limitations": { "type": "array", "maxItems": 300000, "items": { "$ref": "#/$defs/limitation" } },
    "extraction_complete": { "type": "boolean" },
    "ocr_required": { "type": "boolean" },
    "ocr_performed": { "const": false },
    "original_preserved": { "const": true },
    "filesystem_effect_performed": { "const": false },
    "network_access_performed": { "const": false },
    "execution_performed": { "const": false }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "workspace_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "components"],
      "properties": {
        "workspace_id": { "$ref": "#/$defs/identifier" },
        "components": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$" } }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "maximum_source_bytes", "maximum_objects", "maximum_pages", "maximum_decompressed_stream_bytes", "maximum_page_text_bytes", "maximum_total_text_bytes", "minimum_text_characters", "maximum_images_per_page"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/identifier" },
        "maximum_source_bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "maximum_objects": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximum_pages": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maximum_decompressed_stream_bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "maximum_page_text_bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "maximum_total_text_bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "minimum_text_characters": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "maximum_images_per_page": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "page_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "page_number", "object_number", "object_generation", "page_id"],
      "properties": {
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "page_number": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "object_number": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "object_generation": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "page_id": { "$ref": "#/$defs/sha256" }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "fragment_id", "text_sha256", "extraction_method", "confidence_basis_points", "exact_page", "exact_region"],
      "properties": {
        "page": { "$ref": "#/$defs/page_identity" },
        "fragment_id": { "type": "string", "pattern": "^[0-9a-f]{64}:(ocr-)?fragment:[1-9][0-9]*$", "maxLength": 96 },
        "text_sha256": { "$ref": "#/$defs/sha256" },
        "extraction_method": { "enum": ["embedded_text", "local_ocr"] },
        "confidence_basis_points": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "exact_page": { "const": true },
        "exact_region": { "const": false }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "state", "decoded_content_bytes", "image_count", "text", "text_sha256", "extraction_method", "confidence_basis_points", "citation", "limitation_ids"],
      "properties": {
        "identity": { "$ref": "#/$defs/page_identity" },
        "state": { "enum": ["text", "scanned_candidate", "empty", "extraction_limited"] },
        "decoded_content_bytes": { "type": ["integer", "null"], "minimum": 0, "maximum": 536870912 },
        "image_count": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "text": { "type": "string", "maxLength": 536870912 },
        "text_sha256": { "$ref": "#/$defs/sha256" },
        "extraction_method": { "type": ["string", "null"], "enum": ["embedded_text", "local_ocr", null] },
        "confidence_basis_points": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
        "citation": { "anyOf": [{ "$ref": "#/$defs/citation" }, { "type": "null" }] },
        "limitation_ids": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^pdf-limit:[0-9a-f]{64}$" } }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limitation_id", "page_id", "reason_code", "blocks_complete_extraction", "requires_ocr", "original_remains_authoritative"],
      "properties": {
        "limitation_id": { "type": "string", "pattern": "^pdf-limit:[0-9a-f]{64}$" },
        "page_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "reason_code": { "type": "string", "pattern": "^pdf\\.[a-z0-9.-]{1,126}$" },
        "blocks_complete_extraction": { "type": "boolean" },
        "requires_ocr": { "type": "boolean" },
        "original_remains_authoritative": { "const": true }
      }
    }
  }
}
