{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agentmage.dev/schemas/runtime/pull-request-worktree-binding.schema.json","title":"AgentMage Pull Request Worktree Binding","type":"object","additionalProperties":false,"required":["schema_version","binding_id","repository_id","worktree_id","worktree_sha256","base_revision","head_revision","merge_base_revision","fork_repository_id","changed_paths_sha256","dependency_state_sha256","instruction_state_sha256","test_state_sha256","commits_since_review","base_moved","active_checkout_unchanged","remote_state_unchanged"],"properties":{"schema_version":{"const":2},"binding_id":{"$ref":"#/$defs/id"},"repository_id":{"$ref":"#/$defs/id"},"worktree_id":{"$ref":"#/$defs/id"},"worktree_sha256":{"$ref":"#/$defs/sha"},"base_revision":{"$ref":"#/$defs/sha"},"head_revision":{"$ref":"#/$defs/sha"},"merge_base_revision":{"$ref":"#/$defs/sha"},"fork_repository_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"changed_paths_sha256":{"$ref":"#/$defs/sha"},"dependency_state_sha256":{"$ref":"#/$defs/sha"},"instruction_state_sha256":{"$ref":"#/$defs/sha"},"test_state_sha256":{"$ref":"#/$defs/sha"},"commits_since_review":{"type":"integer","minimum":0},"base_moved":{"type":"boolean"},"active_checkout_unchanged":{"const":true},"remote_state_unchanged":{"const":true}},"$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
