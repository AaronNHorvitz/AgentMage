{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agentmage.dev/schemas/runtime/github-read-receipt.schema.json","title":"AgentMage Normalized GitHub Read Receipt","type":"object","additionalProperties":false,
  "required":["schema_version","host","repository_id","actor_id","object_path","immutable_object_id","request_id","operation","result","fresh_at_epoch_milliseconds","next_page_cursor_sha256","cache_validator_sha256","rate_limit_remaining","retry_after_milliseconds","external_state_changed","fresh_grant_required_for_retry","receipt_sha256"],
  "properties":{"schema_version":{"const":2},"host":{"type":"string","pattern":"^[a-z0-9][a-z0-9.-]*[a-z0-9]$"},"repository_id":{"$ref":"#/$defs/id"},"actor_id":{"$ref":"#/$defs/id"},"object_path":{"type":"string","minLength":1,"maxLength":2048},"immutable_object_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"request_id":{"$ref":"#/$defs/id"},"operation":{"enum":["repository_metadata","repository_content","commit_metadata","reference_metadata"]},"result":{"enum":["success","partial","empty","malformed","rate_limited","expired","revoked","unauthorized","forbidden","unavailable","cancelled"]},"fresh_at_epoch_milliseconds":{"type":"integer","minimum":1},"next_page_cursor_sha256":{"$ref":"#/$defs/nullable_sha"},"cache_validator_sha256":{"$ref":"#/$defs/nullable_sha"},"rate_limit_remaining":{"anyOf":[{"type":"integer","minimum":0},{"type":"null"}]},"retry_after_milliseconds":{"anyOf":[{"type":"integer","minimum":0,"maximum":86400000},{"type":"null"}]},"external_state_changed":{"const":false},"fresh_grant_required_for_retry":{"type":"boolean"},"receipt_sha256":{"$ref":"#/$defs/sha"}},
  "$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},"nullable_sha":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]}}
}
