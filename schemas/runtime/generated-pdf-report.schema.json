{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/generated-pdf-report.schema.json",
  "title": "AgentMage Generated PDF Report",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "report_id", "output_path", "generator_identity_sha256", "extractor_identity_sha256", "source_markdown_sha256", "html", "html_sha256", "pdf", "pdf_sha256", "inspection", "fidelity_limits", "local_assets_only", "filesystem_effect_performed", "network_access_performed", "execution_performed"],
  "properties": {
    "schema_version": { "const": 2 }, "report_id": { "$ref": "#/$defs/identifier" }, "output_path": { "$ref": "#/$defs/workspace_path" }, "generator_identity_sha256": { "$ref": "#/$defs/sha256" }, "extractor_identity_sha256": { "$ref": "#/$defs/sha256" }, "source_markdown_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "html": { "type": "array", "maxItems": 8388608, "items": { "$ref": "#/$defs/byte" } }, "html_sha256": { "$ref": "#/$defs/sha256" }, "pdf": { "type": "array", "maxItems": 67108864, "items": { "$ref": "#/$defs/byte" } }, "pdf_sha256": { "$ref": "#/$defs/sha256" }, "inspection": { "$ref": "https://agentmage.dev/schemas/runtime/pdf-artifact-inspection.schema.json" },
    "fidelity_limits": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/limit" } }, "local_assets_only": { "const": true }, "filesystem_effect_performed": { "const": false }, "network_access_performed": { "const": false }, "execution_performed": { "const": false }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }, "code": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "byte": { "type": "integer", "minimum": 0, "maximum": 255 },
    "workspace_path": { "type": "object", "additionalProperties": false, "required": ["workspace_id", "components"], "properties": { "workspace_id": { "$ref": "#/$defs/identifier" }, "components": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$" } } } },
    "limit": { "type": "object", "additionalProperties": false, "required": ["limit_id", "reason_code", "human_review_required"], "properties": { "limit_id": { "$ref": "#/$defs/identifier" }, "reason_code": { "$ref": "#/$defs/code" }, "human_review_required": { "const": true } } }
  }
}
