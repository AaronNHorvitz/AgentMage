{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agentmage.dev/schemas/runtime/github-auth-diagnostic.schema.json","title":"AgentMage GitHub Authentication Diagnostic","type":"object","additionalProperties":false,
  "required":["schema_version","binding_id","canonical_api_host","canonical_clone_host","account_or_app_id","installation_id","repository_ids","effective_permission_scopes","missing_permission_scopes","expires_epoch_milliseconds","single_sign_on_active","enabled","diagnostic_code","credential_reference_id"],
  "properties":{"schema_version":{"const":2},"binding_id":{"$ref":"#/$defs/id"},"canonical_api_host":{"$ref":"#/$defs/host"},"canonical_clone_host":{"$ref":"#/$defs/host"},"account_or_app_id":{"$ref":"#/$defs/id"},"installation_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"repository_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"effective_permission_scopes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"missing_permission_scopes":{"type":"array","maxItems":0},"expires_epoch_milliseconds":{"type":"integer","minimum":1},"single_sign_on_active":{"const":true},"enabled":{"const":true},"diagnostic_code":{"const":"github.authentication.ready"},"credential_reference_id":{"$ref":"#/$defs/id"}},
  "$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"host":{"type":"string","pattern":"^[a-z0-9][a-z0-9.-]*[a-z0-9]$"}}
}
