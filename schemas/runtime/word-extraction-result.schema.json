{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.dev/schemas/runtime/word-extraction-result.schema.json",
  "title": "AgentMage Word Extraction Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_sha256", "conversion_identity_sha256", "cache_key_sha256", "sidecar", "sidecar_sha256", "fragments", "fidelity_warnings", "inspection", "original_preserved", "filesystem_effect_performed", "network_access_performed", "execution_performed"],
  "properties": {
    "schema_version": { "const": 2 },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "conversion_identity_sha256": { "$ref": "#/$defs/sha256" },
    "cache_key_sha256": { "$ref": "#/$defs/sha256" },
    "sidecar": { "type": "array", "maxItems": 134217728, "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
    "sidecar_sha256": { "$ref": "#/$defs/sha256" },
    "fragments": { "type": "array", "maxItems": 1048576, "items": { "$ref": "#/$defs/fragment" } },
    "fidelity_warnings": { "type": "array", "maxItems": 13, "items": { "$ref": "#/$defs/warning" } },
    "inspection": { "$ref": "https://agentmage.dev/schemas/runtime/word-inspection-report.schema.json" },
    "original_preserved": { "const": true },
    "filesystem_effect_performed": { "const": false },
    "network_access_performed": { "const": false },
    "execution_performed": { "const": false }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "feature_kind": { "enum": ["table", "comment", "tracked_insertion", "tracked_deletion", "header", "footer", "numbering", "section_layout", "hyperlink", "image", "field", "style", "unsupported_construct"] },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fragment_id", "source_range", "text", "revision_state"],
      "properties": {
        "fragment_id": { "$ref": "#/$defs/identifier" },
        "source_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["part_name", "start_byte", "end_byte"],
          "properties": {
            "part_name": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "start_byte": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "end_byte": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 4194304 },
        "revision_state": { "enum": ["current", "inserted", "deleted"] }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warning_id", "feature", "observed_count", "reason_code", "original_remains_authoritative"],
      "properties": {
        "warning_id": { "$ref": "#/$defs/identifier" },
        "feature": { "$ref": "#/$defs/feature_kind" },
        "observed_count": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "reason_code": { "$ref": "#/$defs/code" },
        "original_remains_authoritative": { "const": true }
      }
    }
  }
}
