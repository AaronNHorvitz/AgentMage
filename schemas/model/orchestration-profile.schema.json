{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmage.local/schemas/model/orchestration-profile.schema.json",
  "title": "AgentMage compiled model orchestration profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "orchestration_profile_id",
    "model_profile_id",
    "model_manifest_sha256",
    "context",
    "shape",
    "invariant_controls",
    "qualifications",
    "enabled",
    "automatic_fallback",
    "profile_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "orchestration_profile_id": { "$ref": "#/$defs/identity" },
    "model_profile_id": { "$ref": "#/$defs/identity" },
    "model_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "context": { "$ref": "#/$defs/context" },
    "shape": { "$ref": "#/$defs/shape" },
    "invariant_controls": { "$ref": "#/$defs/controls" },
    "qualifications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/qualification" }
    },
    "enabled": { "type": "boolean" },
    "automatic_fallback": { "const": false },
    "profile_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_tokens", "minimum_tokens", "allocated_tokens", "disposition", "reason_code"],
      "properties": {
        "requested_tokens": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "minimum_tokens": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "allocated_tokens": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "disposition": { "enum": ["included", "truncated", "summarized", "omitted"] },
        "reason_code": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["context.source.truncated_to_window", "context.retrieval.summarized_to_window", "context.retrieval.omitted_for_window"] }
          ]
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "model_profile_id",
        "model_manifest_sha256",
        "model_runtime_sha256",
        "tokenizer_sha256",
        "token_counter_sha256",
        "total_window_tokens",
        "system_and_tool_tokens",
        "user_input_tokens",
        "source_artifacts",
        "retrieved_context",
        "workflow_recovery_reserve_tokens",
        "output_reserve_tokens",
        "safety_margin_tokens",
        "unallocated_tokens",
        "plan_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "model_profile_id": { "$ref": "#/$defs/identity" },
        "model_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "model_runtime_sha256": { "$ref": "#/$defs/sha256" },
        "tokenizer_sha256": { "$ref": "#/$defs/sha256" },
        "token_counter_sha256": { "$ref": "#/$defs/sha256" },
        "total_window_tokens": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "system_and_tool_tokens": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "user_input_tokens": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "source_artifacts": { "$ref": "#/$defs/partition" },
        "retrieved_context": { "$ref": "#/$defs/partition" },
        "workflow_recovery_reserve_tokens": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "output_reserve_tokens": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "safety_margin_tokens": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "unallocated_tokens": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "plan_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_horizon", "visible_tool_ids", "max_observation_tokens", "parser_repair", "recovery_scaffolding", "diagnostic_verbosity"],
      "properties": {
        "plan_horizon": { "type": "integer", "minimum": 1, "maximum": 64 },
        "visible_tool_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identity" }
        },
        "max_observation_tokens": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "parser_repair": { "enum": ["none", "one_targeted_repair"] },
        "recovery_scaffolding": { "enum": ["minimal", "bounded_history"] },
        "diagnostic_verbosity": { "enum": ["codes_only", "bounded_explanation"] }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_sha256", "grant_contract_sha256", "approval_policy_sha256", "side_effect_policy_sha256", "retry_policy_sha256", "verifier_policy_sha256", "budget_policy_sha256", "completion_policy_sha256"],
      "properties": {
        "policy_sha256": { "$ref": "#/$defs/sha256" },
        "grant_contract_sha256": { "$ref": "#/$defs/sha256" },
        "approval_policy_sha256": { "$ref": "#/$defs/sha256" },
        "side_effect_policy_sha256": { "$ref": "#/$defs/sha256" },
        "retry_policy_sha256": { "$ref": "#/$defs/sha256" },
        "verifier_policy_sha256": { "$ref": "#/$defs/sha256" },
        "budget_policy_sha256": { "$ref": "#/$defs/sha256" },
        "completion_policy_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "workflow_id", "evidence_sha256", "passed"],
      "properties": {
        "role_id": { "$ref": "#/$defs/identity" },
        "workflow_id": { "$ref": "#/$defs/identity" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "passed": { "const": true }
      }
    }
  }
}
