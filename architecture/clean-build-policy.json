  "commands": [
    {
      "id": "npm-clean-install",
      "argv": [
        "npm",
        "ci",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund"
      ],
      "network": "bootstrap-only"
    },
    {
      "id": "npm-locked-tree",
      "argv": [
        "npm",
        "ls",
        "--all",
        "--json"
      ],
      "network": "disabled-by-client"
    },
    {
      "id": "cargo-fetch",
      "argv": [
        "cargo",
        "fetch",
        "--locked"
      ],
      "network": "bootstrap-only"
    },
    {
      "id": "cargo-locked-tree",
      "argv": [
        "cargo",
        "metadata",
        "--locked",
        "--offline",
        "--format-version",
        "1",
        "--no-deps"
      ],
      "network": "disabled-by-client"
    },
    {
      "id": "build",
      "argv": [
        "npm",
        "run",
        "product:build"
      ],
      "network": "disabled-by-client"
    },
    {
      "id": "lint",
      "argv": [
        "npm",
        "run",
        "product:lint"
      ],
      "network": "disabled-by-client"
    },
    {
      "id": "format-check",
      "argv": [
        "npm",
        "run",
        "product:format-check"
      ],
      "network": "disabled-by-client"
    },
    {
      "id": "test",
      "argv": [
        "npm",
        "run",
        "product:test"
      ],
      "network": "disabled-by-client"
    },
    {
      "id": "sbom-build",
      "argv": [
        "npm",
        "run",
        "supply-chain:build"
      ],
      "network": "disabled-by-client"
    },
    {
      "id": "sbom-check",
      "argv": [
        "npm",
        "run",
        "supply-chain:check"
      ],
      "network": "disabled-by-client"
    },
    {
      "id": "diagnostic",
      "argv": [
        "npm",
        "run",
        "diagnostic:check"
      ],
      "network": "disabled-by-client"
    }
  ],
  "additional_input_paths": [
    "architecture/clean-build-policy.json",
