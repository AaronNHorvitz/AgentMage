{
  "schema_version": 2,
  "status": "enforced",
  "test_id": "S-001-IT01",
  "toolchains": {
    "cargo": "1.95.0",
    "clippy": "0.1.95",
    "node": "24.15.0",
    "npm": "11.12.1",
    "rustc": "1.95.0",
    "rustfmt": "1.9.0-stable"
  },
  "download_integrity": {
    "node_linux_x64_sha256": "472655581fb851559730c48763e0c9d3bc25975c59d518003fc0849d3e4ba0f6",
    "rustup_init_linux_x64_sha256": "4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10"
  },
  "linux_platforms": {
    "fedora-x86_64": {
      "base_image": "docker.io/library/fedora@sha256:89f61a124414261868224666aa7fb8df1b78397a53623774bdfb105d1612b48b",
      "os_id": "fedora",
      "version_id": "44"
    },
    "ubuntu-x86_64": {
      "base_image": "docker.io/library/ubuntu@sha256:7b202b0e2e0028c6250f5fcf41d04df492d145a1654c6995a6553f0c1f6f1960",
      "os_id": "ubuntu",
      "version_id": "26.04"
    }
  },
  "bootstrap_commands": [
    {
      "id": "npm-clean-install",
      "argv": [
        "npm",
        "ci",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund"
      ],
      "network": "bootstrap-container-build"
    },
    {
      "id": "cargo-fetch",
      "argv": ["cargo", "fetch", "--locked"],
      "network": "bootstrap-container-build"
    }
  ],
  "verification_commands": [
    {
      "id": "npm-locked-tree",
      "argv": ["npm", "ls", "--all", "--json"],
      "network": "container-disabled"
    },
    {
      "id": "cargo-locked-tree",
      "argv": [
        "cargo",
        "metadata",
        "--locked",
        "--offline",
        "--format-version",
        "1",
        "--no-deps"
      ],
      "network": "container-disabled"
    },
    {
      "id": "build",
      "argv": ["npm", "run", "product:build"],
      "network": "container-disabled"
    },
    {
      "id": "lint",
      "argv": ["npm", "run", "product:lint"],
      "network": "container-disabled"
    },
    {
      "id": "format-check",
      "argv": ["npm", "run", "product:format-check"],
      "network": "container-disabled"
    },
    {
      "id": "test",
      "argv": ["npm", "run", "product:test"],
      "network": "container-disabled"
    },
    {
      "id": "sbom-build",
      "argv": ["npm", "run", "supply-chain:build"],
      "network": "container-disabled"
    },
    {
      "id": "sbom-check",
      "argv": ["npm", "run", "supply-chain:check"],
      "network": "container-disabled"
    },
    {
      "id": "diagnostic",
      "argv": ["npm", "run", "diagnostic:check"],
      "network": "container-disabled"
    }
  ],
  "source_binding": {
    "identity": "exact-git-commit-and-tree",
    "tracked_scope": "complete-recursive-git-tree",
    "tracked_exclusions": [],
    "reject_dirty_index": true,
    "reject_dirty_worktree": true,
    "reject_untracked_paths": true,
    "reject_tracked_symlinks": true,
    "reject_gitlinks": true,
    "ignored_exclusions": [
      ".env",
      ".env.*",
      "*.key",
      "*.pem",
      "*.p12",
      "*.pfx",
      "*.mobileprovision",
      "*.gguf",
      "*.safetensors",
      "*.onnx",
      "*.sqlite",
      "*.sqlite3",
      "*.db",
      "*.db-wal",
      "*.db-shm",
      "*.log",
      "*.pyc",
      "*.tmp",
      "*.swp",
      ".DS_Store",
      "Thumbs.db",
      ".build/**",
      ".local-models/**",
      ".mermaid-output/**",
      ".vscode-test/**",
      "__pycache__/**",
      "artifacts/**",
      "build/**",
      "coverage/**",
      "dist/**",
      "fixtures/support/manual-patch/trust/**",
      "models/**",
      "node_modules/**",
      "review-evidence/**",
      "shells/vscode/dist/**",
      "target/**"
    ]
  },
  "container_controls": {
    "capabilities": "all-dropped",
    "host_source": "complete-committed-tree-in-image",
    "no_new_privileges": true,
    "root_filesystem": "read-only",
    "runtime": "rootless-podman",
    "runtime_network": "disabled-after-bootstrap",
    "writable_storage": "fresh-tmpfs"
  },
  "execution_user": {
    "gid": 10001,
    "privileged": false,
    "uid": 10001
  },
  "platform_status": {
    "fedora": "executable",
    "macos": "blocked-macos",
    "ubuntu": "executable"
  }
}
