{
  "name": "agentmage-planning-docs",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.12.1 <12"
  },
  "workspaces": [
    "shells/vscode"
  ],
  "scripts": {
    "additions:check": "python3 scripts/additions_only.py",
    "additions:update": "python3 scripts/additions_only.py --update",
    "architecture:check": "python3 scripts/architecture_decision.py",
    "artifact-scan:build": "python3 scripts/artifact_scanner.py --write",
    "artifact-scan:check": "python3 scripts/artifact_scanner.py",
    "build-contract:check": "python3 scripts/build_contract.py",
    "clean-build:check": "python3 scripts/clean_build_evidence.py",
    "clean-build:run": "python3 scripts/clean_build_evidence.py --run-linux --source-revision HEAD",
    "configuration-loader:build": "python3 scripts/configuration_loader_evidence.py --write",
    "configuration-loader:check": "python3 scripts/configuration_loader_evidence.py",
    "configuration-authority:build": "python3 scripts/configuration_authority_evidence.py --write",
    "configuration-authority:check": "python3 scripts/configuration_authority_evidence.py",
    "dependencies:check": "python3 scripts/dependency_rules.py",
    "dependency-classes:check": "python3 scripts/dependency_classes.py",
    "dependency-injection:build": "python3 scripts/dependency_injection.py --write",
    "dependency-injection:check": "python3 scripts/dependency_injection.py",
    "diagnostic:check": "python3 scripts/no_install_diagnostic.py --check",
    "diagnostic:report": "python3 scripts/no_install_diagnostic.py",
    "modules:check": "python3 scripts/module_inventory.py",
    "docs:lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "docs:mermaid": "python3 scripts/check_mermaid.py",
    "docs:validate": "python3 scripts/validate_docs.py",
    "docs:clean-check": "npm ci --ignore-scripts && npm run docs:check",
    "evidence:sprint0:build": "python3 scripts/sprint0_evidence.py --write --source-revision HEAD",
    "evidence:sprint0:check": "python3 scripts/sprint0_evidence.py",
    "evidence:story0.2:build": "python3 scripts/story_0_2_evidence.py --write --source-revision HEAD",
    "evidence:story0.2:check": "python3 scripts/story_0_2_evidence.py",
    "evidence:story0.3:check": "python3 scripts/story_0_3_evidence.py",
    "evidence:story0.3-dmr:check": "python3 scripts/story_0_3_dmr_evidence.py",
    "evidence:story0.3-fallback:build": "python3 scripts/story_0_3_fallback_evidence.py --write --verification-revision HEAD",
    "evidence:story0.3-fallback:check": "python3 scripts/story_0_3_fallback_evidence.py",
    "evidence:story0.3-reachability:check": "python3 scripts/story_0_3_reachability_evidence.py",
    "evidence:story0.3-security:build": "python3 scripts/story_0_3_security_evidence.py --write --verification-revision HEAD",
    "evidence:story0.3-security:check": "python3 scripts/story_0_3_security_evidence.py",
    "evidence:story1.1-artifacts:build": "python3 scripts/story_1_1_artifacts.py --write",
    "evidence:story1.1-artifacts:check": "python3 scripts/story_1_1_artifacts.py",
    "fuzz-gates:check": "python3 scripts/fuzz_story_gate.py",
    "model:source-check": "python3 scripts/model_admission.py",
    "model:corpus-check": "python3 scripts/model_corpus.py",
    "model:disposition-check": "python3 scripts/model_disposition.py",
    "model:fallback-admission-check": "python3 scripts/fallback_admission.py",
    "model:fallback-disposition-check": "python3 scripts/fallback_disposition.py",
    "model:macos-runtime-check": "python3 scripts/macos_runtime_admission.py",
    "model:substitution-build": "python3 scripts/model_substitution.py --write --verification-revision HEAD",
    "model:substitution-check": "python3 scripts/model_substitution.py",
    "resolution:build": "python3 scripts/locked_resolution.py --write",
    "resolution:check": "python3 scripts/locked_resolution.py",
    "product:build": "cargo build --workspace --all-targets --locked && npm run build --workspace @agentmage/vscode-shell",
    "product:check": "npm run product:format-check && npm run product:lint && npm run product:build && npm run product:test",
    "product:format": "cargo fmt --all && npm run format --workspace @agentmage/vscode-shell",
    "product:format-check": "cargo fmt --all -- --check && npm run format:check --workspace @agentmage/vscode-shell",
    "product:lint": "cargo clippy --workspace --all-targets --locked -- -D warnings && npm run lint --workspace @agentmage/vscode-shell",
    "product:macos:build": "swift build --package-path platforms/macos",
    "product:macos:test": "swift test --package-path platforms/macos",
    "product:test": "cargo test --workspace --locked && npm run test --workspace @agentmage/vscode-shell",
    "model:feasibility-test": "python3 -m unittest tests.test_model_feasibility",
    "policy:build": "python3 scripts/policy_expectations.py",
    "policy:check": "python3 scripts/policy_expectations.py --check",
    "references:check": "python3 scripts/security_references.py",
    "requirements:build": "python3 scripts/requirement_registry.py",
    "requirements:coverage": "python3 scripts/requirement_coverage.py",
    "requirements:test": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "requirements:check": "python3 scripts/requirement_registry.py --check && npm run additions:check && npm run architecture:check && npm run modules:check && npm run dependencies:check && npm run dependency-injection:check && npm run resolution:check && npm run build-contract:check && npm run dependency-classes:check && npm run supply-chain:check && npm run artifact-scan:check && npm run diagnostic:check && npm run policy:check && npm run references:check && npm run traceability:check && npm run fuzz-gates:check && npm run configuration-loader:check && npm run configuration-authority:check && npm run evidence:sprint0:check && npm run evidence:story0.2:check && npm run evidence:story0.3:check && npm run evidence:story0.3-dmr:check && npm run evidence:story0.3-fallback:check && npm run evidence:story0.3-reachability:check && npm run evidence:story0.3-security:check && npm run evidence:story1.1-artifacts:check && npm run model:source-check && npm run model:corpus-check && npm run model:disposition-check && npm run model:fallback-admission-check && npm run model:fallback-disposition-check && npm run model:macos-runtime-check && npm run model:substitution-check && npm run requirements:coverage && npm run requirements:test",
    "schemas:validate": "node scripts/validate_planning_schemas.mjs",
    "schemas:test": "node --test tests/test_planning_schemas.mjs",
    "schemas:check": "npm run schemas:validate && npm run schemas:test",
    "supply-chain:build": "python3 scripts/supply_chain.py --write",
    "supply-chain:check": "python3 scripts/supply_chain.py",
    "traceability:build": "python3 scripts/traceability_report.py",
    "traceability:check": "python3 scripts/traceability_report.py --check",
    "traceability:clean": "python3 scripts/verify_clean_traceability.py",
    "docs:check": "npm run docs:lint && npm run docs:mermaid && npm run docs:validate && npm run requirements:check && npm run schemas:check"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.16.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "markdownlint-cli2": "0.23.2"
  }
}
