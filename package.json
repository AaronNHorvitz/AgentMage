{
  "name": "agentmage-planning-docs",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "additions:check": "python3 scripts/additions_only.py",
    "additions:update": "python3 scripts/additions_only.py --update",
    "docs:lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "docs:mermaid": "python3 scripts/check_mermaid.py",
    "docs:validate": "python3 scripts/validate_docs.py",
    "docs:clean-check": "npm ci --ignore-scripts && npm run docs:check",
    "evidence:sprint0:build": "python3 scripts/sprint0_evidence.py --write --source-revision HEAD",
    "evidence:sprint0:check": "python3 scripts/sprint0_evidence.py",
    "evidence:story0.2:build": "python3 scripts/story_0_2_evidence.py --write --source-revision HEAD",
    "evidence:story0.2:check": "python3 scripts/story_0_2_evidence.py",
    "policy:build": "python3 scripts/policy_expectations.py",
    "policy:check": "python3 scripts/policy_expectations.py --check",
    "references:check": "python3 scripts/security_references.py",
    "requirements:build": "python3 scripts/requirement_registry.py",
    "requirements:coverage": "python3 scripts/requirement_coverage.py",
    "requirements:test": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "requirements:check": "python3 scripts/requirement_registry.py --check && npm run additions:check && npm run policy:check && npm run references:check && npm run traceability:check && npm run evidence:sprint0:check && npm run evidence:story0.2:check && npm run requirements:coverage && npm run requirements:test",
    "schemas:validate": "node scripts/validate_planning_schemas.mjs",
    "schemas:test": "node --test tests/test_planning_schemas.mjs",
    "schemas:check": "npm run schemas:validate && npm run schemas:test",
    "traceability:build": "python3 scripts/traceability_report.py",
    "traceability:check": "python3 scripts/traceability_report.py --check",
    "traceability:clean": "python3 scripts/verify_clean_traceability.py",
    "docs:check": "npm run docs:lint && npm run docs:mermaid && npm run docs:validate && npm run requirements:check && npm run schemas:check"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.16.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "markdownlint-cli2": "0.23.2"
  }
}
